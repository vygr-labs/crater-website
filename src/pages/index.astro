---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";

import heroConsole from "../assets/shots/hero-console.webp";
import projScripture from "../assets/shots/proj-scripture.webp";
import projSong from "../assets/shots/proj-song.webp";
import projSong2 from "../assets/shots/proj-song-2.webp";
import projSongReel from "../assets/shots/proj-song-reel.webp";
import projSongCyan from "../assets/shots/proj-song-cyan.webp";
import consoleScripture from "../assets/shots/console-scripture.webp";
import projSermon from "../assets/shots/proj-sermon.webp";
import projCountdown from "../assets/shots/proj-countdown.webp";
import projStrongs from "../assets/shots/proj-strongs.webp";
import projStage from "../assets/shots/proj-stage.webp";
import consoleThemes from "../assets/shots/console-themes.webp";
import consoleMedia from "../assets/shots/console-media.webp";
import schedule from "../assets/shots/schedule.webp";

const DOCS = "https://crater.voyagerlabs.tech/";
const CHANNEL = "https://www.youtube.com/@craterbibleproject";
const RELEASES = "https://github.com/vygr-labs/crater-v2/releases";
const LATEST = `${RELEASES}/latest`;

// Same ids and order as HelpLinks.cpp in the app.
const yt = (id: string) => `https://www.youtube.com/playlist?list=${id}`;
const playlists = [
	["Getting started", "PLeTrWoINYOdc"],
	["Scripture", "PLNO9VmlLIHvc"],
	["Songs", "PLcyNZxoeJ3Jg"],
	["Media and sermon slides", "PLBAJHRdNjqYQ"],
	["Planning the service", "PLXZDtD0pzOe0"],
	["Themes", "PLdevLN2YWRz4"],
	["Screens and streaming", "PLeIJbC4poGcQ"],
	["Settings and profiles", "PLegIh7LuDbIU"],
	["Keyboard shortcuts", "PLaRLc4BRkAx0"],
].map(([label, id], i) => ({ label, url: yt(id), n: String(i + 1).padStart(2, "0") }));

const reel = [
	{ img: projSongReel, title: "Songs", note: "Lyrics, verse by verse", alt: "It Is Well with My Soul on the projector" },
	{ img: projScripture, title: "Scripture", note: "Highlight as you preach", alt: "John 3:16 with highlighted words" },
	{ img: projSermon, title: "Sermon slides", note: "Built right in Crater", alt: "A sermon title slide" },
	{ img: projStrongs, title: "Strong's", note: "The Greek and Hebrew behind a word", alt: "A Strong's definition for agape" },
	{ img: projStage, title: "Stage display", note: "Now, next and your notes", alt: "The stage display with current and next slide" },
	{ img: projCountdown, title: "Countdowns", note: "Start on time", alt: "A countdown before the service" },
];

const marquee = [
	"Scripture",
	"Songs",
	"Sermon slides",
	"Media",
	"Countdowns",
	"Stage display",
	"Strong's",
	"Themes",
	"NDI output",
	"Cast to a TV",
	"Profiles",
	"Keyboard first",
];

const statement = "Built for the laptop already in the booth, and the volunteer who has never run a service before.";

const faqs = [
	[
		"Is Crater really free?",
		"Yes. Free to download and use on as many computers as you like, with no trial and no licence. The code is open source, so it belongs to the community rather than a company.",
	],
	[
		"Will it run on our old church laptop?",
		"Almost certainly. Crater is built to feel quick on modest machines with 4 GB of RAM. If it runs Windows 10, it will very likely run Crater well.",
	],
	[
		"Do our volunteers need to be technical?",
		"No. If you can put together a slideshow you can run a service. The tutorial playlists walk through each task in a few minutes.",
	],
	[
		"Can we send the screen to our live stream?",
		"Yes. Crater sends its output over NDI, which OBS and most streaming tools already understand. No capture card needed.",
	],
	["Is our information private?", "Completely. No accounts, no tracking, no analytics. Your songs and services stay on your computer."],
];
---

<Base
	title="Crater · Free worship projection for churches"
	description="Free, open source worship projection software. Scripture, songs, media and sermon slides on the screen from one calm console. Windows, macOS and Linux."
>
	<header class="nav-wrap">
		<nav class="nav" aria-label="Main">
			<a href="#top" class="brand" aria-label="Crater home">
				<Mark size={26} />
				<span>Crater</span>
			</a>
			<div class="nav-links">
				<a href="#features">Features</a>
				<a href="#room">On screen</a>
				<a href="#tutorials">Tutorials</a>
				<a href={DOCS}>Docs</a>
			</div>
			<div class="nav-end">
				<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to light mode">
					<svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
					<svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11Z"></path></svg>
				</button>
				<a href="#download" class="nav-cta" data-magnetic>Download</a>
			</div>
		</nav>
	</header>

	<main>
		<!-- HERO -->
		<section id="top" class="hero">
			<div class="sun" aria-hidden="true"></div>
			<div class="arc" aria-hidden="true"></div>
			<div class="hero-copy wrap">
				<div class="pill" data-hero-in>
					<span class="pill-tag">Free</span>
					Open source worship projection for Windows, Mac and Linux
				</div>
				<h1 class="display hero-title" aria-label="Put the Word on the wall.">
					<span class="line"><span class="w">Put</span> <span class="w">the</span> <span class="w"><span class="hl" data-hl>Word</span></span></span>
					<span class="line"><span class="w">on</span> <span class="w">the</span> <span class="w">wall.</span></span>
				</h1>
				<p class="hero-lede lede" data-hero-in>
					Scripture, songs, media and sermon slides on the screen from one calm console. Free for every church, light enough for the laptop already in
					the booth.
				</p>
				<div class="hero-ctas" data-hero-in>
					<a href="#download" class="btn btn-brand" data-magnetic>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg>
						Download for free
					</a>
					<a href={playlists[0].url} class="btn btn-ghost" data-magnetic>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M10 8.5v7l6-3.5-6-3.5Z"></path></svg>
						Watch the tour
					</a>
				</div>
				<p class="hero-note" data-hero-in>No account. No trial. Nothing leaves the building.</p>
			</div>

			<div class="stage wrap">
				<div class="screen" data-screen>
					<Image src={heroConsole} alt="The Crater console with Amazing Grace live, the next verse lined up, and the song library below" widths={[960, 1440, 1920]} sizes="96vw" loading="eager" fetchpriority="high" />
					<div class="screen-sheen" aria-hidden="true"></div>
				</div>
				<div class="float-proj" data-float>
					<Image src={projSong} alt="The projector showing the first verse of Amazing Grace" widths={[480, 800]} sizes="34vw" loading="eager" />
					<span class="live-badge"><span class="dot"></span>LIVE</span>
				</div>
			</div>
		</section>

		<!-- MARQUEE -->
		<section class="marquee" aria-label="What Crater does">
			<div class="marquee-track" data-marquee>
				{
					[0, 1].map((copy) => (
						<ul aria-hidden={copy === 1 ? "true" : undefined}>
							{marquee.map((m) => (
								<li>
									<span class="sep" aria-hidden="true" />
									{m}
								</li>
							))}
						</ul>
					))
				}
			</div>
		</section>

		<!-- FACTS -->
		<section class="facts wrap" aria-label="At a glance">
			<div class="fact" data-reveal="up">
				<span class="fact-n">Free</span>
				<span class="fact-l">On every machine, for good</span>
			</div>
			<div class="fact" data-reveal="up">
				<span class="fact-n"><span data-count="1.5" data-decimals="1">1.5</span> s</span>
				<span class="fact-l">From click to ready</span>
			</div>
			<div class="fact" data-reveal="up">
				<span class="fact-n"><span data-count="4">4</span> GB</span>
				<span class="fact-l">Of RAM is plenty</span>
			</div>
			<div class="fact" data-reveal="up">
				<span class="fact-n"><span data-count="3">3</span></span>
				<span class="fact-l">Windows, macOS and Linux</span>
			</div>
		</section>

		<!-- WHAT THE ROOM SEES: pinned horizontal reel -->
		<section id="room" class="room" data-reel>
			<div class="room-pin">
				<div class="wrap room-head">
					<div>
						<p class="eyebrow" data-reveal="up">What the room sees</p>
						<h2 class="display h2" data-reveal="up">Every slide, <span class="hl" data-hl>beautifully</span> set.</h2>
					</div>
					<p class="lede room-note" data-reveal="up">Real output from Crater, straight off the projector. No mockups, no retouching.</p>
				</div>
				<div class="reel" data-reel-track>
					{
						reel.map((r, i) => (
							<figure class="reel-item">
								<div class="reel-frame">
									<Image src={r.img} alt={r.alt} widths={[640, 1280]} sizes="(max-width: 800px) 86vw, 52vw" />
								</div>
								<figcaption>
									<span class="reel-n">{String(i + 1).padStart(2, "0")}</span>
									<span class="reel-t">{r.title}</span>
									<span class="reel-d">{r.note}</span>
								</figcaption>
							</figure>
						))
					}
				</div>
				<div class="wrap reel-progress" aria-hidden="true"><span data-reel-bar></span></div>
			</div>
		</section>

		<!-- FEATURES -->
		<section id="features" class="features wrap">
			<div class="section-head center">
				<p class="eyebrow" data-reveal="up">Everything a service needs</p>
				<h2 class="display h2" data-reveal="up">Plan in the week. <span class="hl" data-hl>Breathe</span> on Sunday.</h2>
			</div>

			<div class="grid">
				<article class="card feat feat-wide" data-reveal="card" data-spot>
					<div class="feat-copy">
						<h3>Find any verse as you type.</h3>
						<p class="lede">
							Type a reference, or a few words you remember. Crater reads "jn 3 16" and "for god so loved" the same way, across every translation you have.
							Strong's numbers are one tab away.
						</p>
						<div class="chips">
							<span class="chip">Instant search</span>
							<span class="chip">Many translations</span>
							<span class="chip">Strong's</span>
						</div>
					</div>
					<div class="feat-shot" data-parallax-box>
						<Image src={consoleScripture} alt="Scripture search results for John 3 16" widths={[800, 1280]} sizes="(max-width: 900px) 100vw, 62vw" data-parallax />
					</div>
				</article>

				<article class="card feat" data-reveal="card" data-spot>
					<div>
						<h3>Themes you set once.</h3>
						<p class="lede">Fonts, colours and backgrounds with a live preview. Save it, reuse it every week, share it in one file.</p>
					</div>
					<div class="feat-shot" data-parallax-box>
						<Image src={consoleThemes} alt="The theme editor" widths={[640, 1200]} sizes="(max-width: 1060px) 100vw, 48vw" data-parallax />
					</div>
				</article>

				<article class="card feat" data-reveal="card" data-spot>
					<div>
						<h3>Media and countdowns.</h3>
						<p class="lede">Videos, images and timers sit in the same schedule as your songs. Loop a background, count the room in.</p>
					</div>
					<div class="feat-shot" data-parallax-box>
						<Image src={consoleMedia} alt="The media library with a countdown in preview and live" widths={[640, 1200]} sizes="(max-width: 900px) 100vw, 600px" data-parallax />
					</div>
				</article>

				<!-- Preview and live: the next slide waits in gold, then takes the wall. -->
				<article class="card feat feat-sm" data-reveal="card" data-spot>
					<div class="golive" data-golive aria-label="A slide waiting in preview, then going live" role="img">
						<div class="gl-pane gl-preview">
							<span class="tag tag-gold">PREVIEW</span>
							<div class="gl-slot">
								<Image src={projSong2} alt="" widths={[480]} sizes="200px" data-gl-a />
								<Image src={projScripture} alt="" widths={[480]} sizes="200px" data-gl-b />
							</div>
						</div>
						<div class="gl-arrow" aria-hidden="true">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
						</div>
						<div class="gl-pane gl-live">
							<span class="tag tag-live"><span class="dot"></span>LIVE</span>
							<div class="gl-slot">
								<Image src={projSong} alt="" widths={[480]} sizes="200px" data-gl-live />
							</div>
						</div>
					</div>
					<h3>See it before the room does.</h3>
					<p class="lede">Line up the next slide in gold while the room watches red. One key sends it.</p>
				</article>

				<!-- Stream: the live output arriving in a broadcast monitor over NDI. -->
				<article class="card feat feat-sm" data-reveal="card" data-spot>
					<div class="monitor" aria-label="Crater's live output arriving in a stream over NDI" role="img">
						<div class="mon-bar">
							<span class="mon-rec"><span class="dot"></span>REC</span>
							<span class="mon-src">NDI · CRATER</span>
							<span class="mon-meter" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
						</div>
						<div class="mon-screen">
							<Image src={projSongCyan} alt="" widths={[640]} sizes="320px" />
							<span class="mon-scan" aria-hidden="true"></span>
						</div>
					</div>
					<h3>Straight into your stream.</h3>
					<p class="lede">Send the screen to OBS over NDI. No capture card, no second laptop.</p>
				</article>

				<!-- Order of service: the real schedule panel. -->
				<article class="card feat feat-sm" data-reveal="card" data-spot>
					<div class="sched" data-parallax-box>
						<Image src={schedule} alt="The schedule with songs, a reading, sermon slides and a video in order" widths={[480, 800]} sizes="(max-width: 900px) 100vw, 400px" data-parallax />
					</div>
					<h3>The whole order of service.</h3>
					<p class="lede">Songs, readings, slides and videos in one list. Drag to reorder, it saves as you go.</p>
				</article>
			</div>
		</section>

		<!-- STATEMENT: words light up as you scroll -->
		<section class="statement wrap" aria-label={statement}>
			<p class="display statement-text" data-scrub-words aria-hidden="true">
				{statement.split(" ").map((w) => <span>{w} </span>)}
			</p>
		</section>

		<!-- QUOTE -->
		<section class="quote wrap">
			<figure data-reveal="up">
				<blockquote class="display">"I got tired of paying for projection software, so I built one the whole church could own."</blockquote>
				<figcaption><span class="rule"></span>Eyetu Kingsley, Crater's maker, Lagos</figcaption>
			</figure>
		</section>

		<!-- TUTORIALS -->
		<section id="tutorials" class="wrap">
			<div class="card tutorials" data-reveal="card">
				<div class="tut-copy">
					<p class="eyebrow">Learn it in an afternoon</p>
					<h2 class="display tut-title">Short videos for <span class="hl" data-hl>every</span> volunteer.</h2>
					<p class="lede">Each one covers a single task in a few minutes. Hand the playlist to whoever runs the booth this week.</p>
					<a href={CHANNEL} class="link-arrow">
						Open the channel
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
					</a>
				</div>
				<ol class="tut-list">
					{
						playlists.map((p) => (
							<li data-reveal="row">
								<a href={p.url}>
									<span class="tut-n">{p.n}</span>
									<span class="tut-l">{p.label}</span>
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<circle cx="12" cy="12" r="10" />
										<path d="M10 8.5v7l6-3.5-6-3.5Z" />
									</svg>
								</a>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- FAQ -->
		<section id="faq" class="faq wrap">
			<div class="faq-head">
				<h2 class="display h2" data-reveal="up">Good <span class="hl" data-hl>questions</span>.</h2>
				<p class="lede" data-reveal="up">Something else on your mind? <a href={DOCS} class="inline-link">Read the docs</a> or ask on GitHub.</p>
			</div>
			<div class="faq-list">
				{
					faqs.map(([q, a]) => (
						<details data-reveal="row">
							<summary>
								{q}
								<span class="plus" aria-hidden="true" />
							</summary>
							<div class="faq-a">
								<p class="lede">{a}</p>
							</div>
						</details>
					))
				}
			</div>
		</section>

		<!-- DOWNLOAD -->
		<section id="download" class="download">
			<div class="sun sun-2" aria-hidden="true" data-sun-2></div>
			<div class="wrap download-inner">
				<div data-reveal="up"><Mark size={56} /></div>
				<h2 class="display download-title" data-reveal="up">Ready for <span class="hl" data-hl>Sunday</span>.</h2>
				<p class="lede" data-reveal="up">Pick your computer, run the installer, open your first service. That is the whole setup.</p>
				<div class="platforms">
					<a href={LATEST} class="platform" data-reveal="card" data-spot>
						<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5.5 10.5 4.5v7H3zM11.5 4.4 21 3v8.5h-9.5zM3 12.5h7.5v7L3 18.5zM11.5 12.5H21V21l-9.5-1.4z"></path></svg>
						<span class="p-name">Windows</span>
						<span class="p-note">Installer for Windows 10 and 11</span>
					</a>
					<a href={LATEST} class="platform" data-reveal="card" data-spot>
						<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
						<span class="p-name">macOS</span>
						<span class="p-note">Apple silicon and Intel</span>
					</a>
					<a href={LATEST} class="platform" data-reveal="card" data-spot>
						<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 17 6-6-6-6M12 19h8"></path></svg>
						<span class="p-name">Linux</span>
						<span class="p-note">AppImage for x86-64</span>
					</a>
				</div>
				<p class="dl-note" data-reveal="up">About 200 MB · <a href={RELEASES}>All releases</a></p>
			</div>
		</section>
	</main>

	<footer class="footer">
		<div class="wrap foot-top">
			<div class="foot-brand">
				<a href="#top" class="brand"><Mark size={24} /><span>Crater</span></a>
				<p>Free, open source worship projection. Built for the church and given back to it.</p>
			</div>
			<div class="foot-cols">
				<div>
					<span class="foot-h">Product</span>
					<a href="#features">Features</a>
					<a href="#tutorials">Tutorials</a>
					<a href="#download">Download</a>
				</div>
				<div>
					<span class="foot-h">Project</span>
					<a href={DOCS}>Documentation</a>
					<a href="https://github.com/vygr-labs/crater-v2">Source on GitHub</a>
					<a href={CHANNEL}>YouTube</a>
				</div>
			</div>
		</div>
		<div class="wordmark" aria-hidden="true" data-wordmark>Crater</div>
		<div class="wrap foot-bottom">
			<span>Love and peace to you all by the mercies of our God.</span>
			<span>© 2026 Crater</span>
		</div>
	</footer>
</Base>

<style>
	/* NAV */
	.nav-wrap {
		position: fixed;
		inset: 0 0 auto;
		z-index: 50;
		display: flex;
		justify-content: center;
		padding: 18px var(--gutter) 0;
		pointer-events: none;
	}
	.nav {
		pointer-events: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		width: 100%;
		max-width: calc(var(--wrap) - 2 * var(--gutter));
		padding: 8px 8px 8px 18px;
		border-radius: 999px;
		background: var(--nav);
		border: 1px solid var(--line);
		backdrop-filter: blur(16px) saturate(1.4);
		-webkit-backdrop-filter: blur(16px) saturate(1.4);
		transition:
			transform 0.6s var(--ease-out),
			background-color 0.5s ease,
			border-color 0.5s ease;
	}
	:global(.nav-hidden) .nav {
		transform: translateY(-140%);
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 19px;
		letter-spacing: -0.01em;
	}
	.nav-links {
		display: flex;
		gap: 4px;
		font-size: 15px;
		color: var(--ink-2);
	}
	.nav-links a {
		position: relative;
		padding: 10px 14px;
		transition: color 0.25s ease;
	}
	.nav-links a::after {
		content: "";
		position: absolute;
		left: 14px;
		right: 14px;
		bottom: 6px;
		height: 1px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 0.45s var(--ease-out);
	}
	.nav-links a:hover {
		color: var(--ink);
	}
	.nav-links a:hover::after {
		transform: scaleX(1);
		transform-origin: left;
	}
	.nav-end {
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.theme-toggle {
		position: relative;
		width: 44px;
		height: 44px;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: transparent;
		color: var(--ink-2);
		display: grid;
		place-items: center;
		cursor: pointer;
		overflow: hidden;
		transition: color 0.25s ease, border-color 0.25s ease;
	}
	.theme-toggle:hover {
		color: var(--ink);
		border-color: var(--line-strong);
	}
	.theme-toggle svg {
		grid-area: 1 / 1;
		transition:
			transform 0.6s var(--ease-out),
			opacity 0.4s ease;
	}
	:global([data-theme="dark"]) .i-moon,
	:global([data-theme="light"]) .i-sun {
		transform: translateY(140%) rotate(90deg);
		opacity: 0;
	}
	.nav-cta {
		display: inline-flex;
		align-items: center;
		height: 44px;
		padding: 0 20px;
		border-radius: 999px;
		background: var(--ink);
		color: var(--bg);
		font-weight: 600;
		font-size: 15px;
		transition: transform 0.4s var(--ease-out), background-color 0.5s ease, color 0.5s ease;
	}
	@media (max-width: 720px) {
		.nav-links {
			display: none;
		}
	}

	/* HERO */
	.hero {
		position: relative;
		padding-top: 168px;
		text-align: center;
	}
	.sun {
		position: absolute;
		left: 50%;
		top: 560px;
		width: 1500px;
		height: 1500px;
		margin-left: -750px;
		border-radius: 50%;
		background: radial-gradient(closest-side, var(--glow), transparent 72%);
		pointer-events: none;
		will-change: transform, opacity;
	}
	.arc {
		position: absolute;
		left: 50%;
		top: 640px;
		width: 1240px;
		height: 1240px;
		margin-left: -620px;
		border-radius: 50%;
		border-top: 1px solid var(--arc);
		pointer-events: none;
		mask-image: linear-gradient(90deg, transparent, #000 30%, #000 70%, transparent);
	}
	.hero-copy {
		position: relative;
		max-width: 1000px;
	}
	.pill {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 7px 14px 7px 8px;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--card);
		font-size: 14px;
		color: var(--ink-2);
	}
	.pill-tag {
		padding: 3px 10px;
		border-radius: 999px;
		background: var(--brand-wash);
		color: var(--brand);
		font-weight: 600;
		font-size: 12px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.hero-title {
		margin-top: 32px;
		font-size: clamp(52px, 8.4vw, 120px);
		line-height: 0.98;
	}
	.hero-title .line {
		display: block;
	}
	.hero-title .w {
		display: inline-block;
		overflow: clip;
		overflow-clip-margin: 0.12em;
		padding-bottom: 0.06em;
		vertical-align: top;
	}
	.hero-lede {
		margin: 28px auto 0;
		max-width: 620px;
		font-size: 19px;
	}
	.hero-ctas {
		display: flex;
		gap: 12px;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 40px;
	}
	.hero-note {
		margin: 18px 0 0;
		font-size: 14px;
		color: var(--ink-3);
	}
	.stage {
		position: relative;
		margin-top: 88px;
		perspective: 1800px;
	}
	.screen {
		position: relative;
		border-radius: 18px;
		padding: 10px;
		background: var(--frame);
		border: 1px solid var(--line-strong);
		box-shadow:
			0 40px 120px -20px var(--shadow),
			0 0 0 1px var(--line);
		transform-origin: 50% 0%;
		will-change: transform;
	}
	.screen :global(img) {
		width: 100%;
		border-radius: 10px;
	}
	.screen-sheen {
		position: absolute;
		inset: 10px;
		border-radius: 10px;
		background: linear-gradient(115deg, transparent 35%, rgb(255 255 255 / 0.07) 50%, transparent 65%);
		background-size: 250% 100%;
		background-position: 120% 0;
		pointer-events: none;
	}
	.float-proj {
		position: absolute;
		right: -4px;
		bottom: -56px;
		width: 34%;
		min-width: 200px;
		border-radius: 14px;
		padding: 6px;
		background: var(--frame);
		border: 1px solid var(--line-strong);
		box-shadow: 0 30px 80px -10px var(--shadow);
		will-change: transform;
	}
	.float-proj :global(img) {
		border-radius: 9px;
	}
	.live-badge {
		position: absolute;
		left: 18px;
		top: 18px;
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 4px 10px;
		border-radius: 6px;
		background: #c9372c;
		color: #fff;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.08em;
	}
	.dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: currentColor;
		animation: pulse 1.6s ease-in-out infinite;
	}
	@keyframes pulse {
		50% {
			opacity: 0.35;
		}
	}

	/* MARQUEE */
	.marquee {
		margin-top: 150px;
		border-block: 1px solid var(--line);
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
	}
	.marquee-track {
		display: flex;
		width: max-content;
		animation: marquee 48s linear infinite;
	}
	.marquee:hover .marquee-track {
		animation-play-state: paused;
	}
	.marquee ul {
		display: flex;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.marquee li {
		display: flex;
		align-items: center;
		gap: 28px;
		padding: 26px 28px 26px 0;
		font-family: var(--font-display);
		font-size: 26px;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--ink-2);
		white-space: nowrap;
	}
	.marquee .sep {
		width: 8px;
		height: 8px;
		border-radius: 2px;
		background: var(--brand);
		transform: rotate(45deg);
	}
	@keyframes marquee {
		to {
			transform: translateX(-50%);
		}
	}

	/* FACTS */
	.facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		margin-top: 0;
	}
	.fact {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 36px 24px;
		border-bottom: 1px solid var(--line);
	}
	.fact + .fact {
		border-left: 1px solid var(--line);
	}
	.fact-n {
		font-family: var(--font-display);
		font-size: 44px;
		font-weight: 600;
		letter-spacing: -0.03em;
		font-variant-numeric: tabular-nums;
	}
	.fact-l {
		font-size: 15px;
		color: var(--ink-2);
	}
	@media (max-width: 960px) {
		.fact + .fact {
			border-left: 0;
		}
	}

	/* ROOM REEL */
	.room {
		position: relative;
		margin-top: 140px;
	}
	.room-pin {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 48px;
		padding-block: 72px 40px;
		overflow: hidden;
	}
	.room-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 32px;
		flex-wrap: wrap;
	}
	.room-head h2 {
		margin-top: 16px;
	}
	.room-note {
		max-width: 400px;
		margin: 0;
	}
	.reel {
		display: flex;
		gap: 28px;
		width: max-content;
		padding-inline: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
		will-change: transform;
	}
	.reel-item {
		margin: 0;
		width: min(52vw, 760px);
	}
	.reel-frame {
		position: relative;
		border-radius: 16px;
		overflow: hidden;
		border: 1px solid var(--line-strong);
		box-shadow: 0 30px 80px -30px var(--shadow);
		aspect-ratio: 16 / 9;
	}
	.reel-frame :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.12);
		will-change: transform;
	}
	.reel-item figcaption {
		display: flex;
		align-items: baseline;
		gap: 14px;
		margin-top: 16px;
		font-size: 16px;
	}
	.reel-n {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--brand);
	}
	.reel-t {
		font-weight: 600;
	}
	.reel-d {
		margin-left: auto;
		color: var(--ink-3);
	}
	.reel-progress {
		height: 2px;
	}
	.reel-progress span {
		display: block;
		height: 100%;
		background: linear-gradient(90deg, var(--brand), var(--gold));
		transform: scaleX(0);
		transform-origin: left;
		border-radius: 2px;
	}
	@media (max-width: 800px) {
		.reel {
			width: auto;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			padding-bottom: 8px;
		}
		.reel-item {
			width: 86vw;
			flex: none;
			scroll-snap-align: center;
		}
		.reel-progress {
			display: none;
		}
	}

	/* FEATURES */
	.features {
		padding-top: 140px;
	}
	.section-head.center {
		text-align: center;
		max-width: 780px;
		margin: 0 auto;
	}
	.section-head h2 {
		margin-top: 16px;
	}
	.grid {
		margin-top: 64px;
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 20px;
	}
	.feat {
		position: relative;
		grid-column: span 3;
		display: flex;
		flex-direction: column;
		gap: 28px;
		padding: 40px;
		overflow: hidden;
		isolation: isolate;
	}
	.feat-wide {
		grid-column: 1 / -1;
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
		gap: 40px;
		padding: 48px;
	}
	.feat-sm {
		grid-column: span 2;
		gap: 0;
		padding: 28px;
	}
	.feat-sm h3 {
		margin-top: 26px;
		font-size: 22px;
	}
	.feat-sm .lede {
		font-size: 16px;
	}
	/* cursor spotlight */
	.feat::before,
	.platform::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(480px circle at var(--mx, 50%) var(--my, -40%), var(--brand-wash), transparent 60%);
		opacity: 0;
		transition: opacity 0.4s ease;
	}
	.feat:hover::before,
	.platform:hover::before {
		opacity: 1;
	}
	.feat h3 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 26px;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}
	.feat-wide h3 {
		font-size: 34px;
	}
	.feat .lede {
		margin: 12px 0 0;
	}
	.feat-copy {
		flex: 1 1 320px;
		min-width: 0;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 24px;
	}
	.feat-shot {
		position: relative;
		margin-top: auto;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid var(--line);
	}
	.feat-wide .feat-shot {
		flex: 2 1 520px;
		min-width: 0;
		margin-top: 0;
	}
	.feat-shot :global(img) {
		width: 100%;
		transform: scale(1.08);
		will-change: transform;
	}

	/* go live demo */
	.golive {
		position: relative;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 10px;
		align-content: center;
		aspect-ratio: 16 / 10;
		padding: 16px;
		border-radius: 14px;
		background: var(--bg-2);
		border: 1px solid var(--line);
	}
	.gl-pane {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
	}
	.gl-slot {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: 6px;
		overflow: hidden;
	}
	.gl-preview .gl-slot {
		box-shadow: 0 0 0 2px var(--gold);
	}
	.gl-live .gl-slot {
		box-shadow: 0 0 0 2px var(--live);
	}
	.gl-slot :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.gl-arrow {
		color: var(--ink-3);
		margin-top: 26px;
	}
	.tag .dot {
		width: 5px;
		height: 5px;
	}

	/* stream monitor */
	.monitor {
		display: flex;
		flex-direction: column;
		aspect-ratio: 16 / 10;
		border-radius: 14px;
		overflow: hidden;
		background: #050607;
		border: 1px solid var(--line);
	}
	.mon-bar {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 12px;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.08em;
		color: #9aa5a9;
		border-bottom: 1px solid rgb(255 255 255 / 0.06);
	}
	.mon-rec {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: #f26b5b;
	}
	.mon-src {
		padding: 2px 8px;
		border-radius: 4px;
		background: rgb(47 211 230 / 0.12);
		color: #2fd3e6;
	}
	.mon-meter {
		margin-left: auto;
		display: flex;
		align-items: flex-end;
		gap: 2px;
		height: 12px;
	}
	.mon-meter i {
		width: 3px;
		background: #3ddc84;
		border-radius: 1px;
		animation: meter 0.9s ease-in-out infinite alternate;
	}
	.mon-meter i:nth-child(2) { animation-delay: -0.3s; }
	.mon-meter i:nth-child(3) { animation-delay: -0.6s; }
	.mon-meter i:nth-child(4) { animation-delay: -0.15s; }
	.mon-meter i:nth-child(5) { animation-delay: -0.45s; }
	@keyframes meter {
		from { height: 20%; }
		to { height: 100%; }
	}
	.mon-screen {
		position: relative;
		flex: 1;
		min-height: 0;
	}
	.mon-screen :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.mon-scan {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent, rgb(47 211 230 / 0.12) 50%, transparent);
		background-size: 100% 40%;
		background-repeat: no-repeat;
		animation: scan 3.2s linear infinite;
		mix-blend-mode: screen;
	}
	@keyframes scan {
		from { background-position: 0 -60%; }
		to { background-position: 0 160%; }
	}

	.sched {
		position: relative;
		border-radius: 14px;
		overflow: hidden;
		border: 1px solid var(--line);
		aspect-ratio: 16 / 10;
	}
	.sched :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: left top;
		transform: scale(1.08);
	}

	@media (max-width: 1060px) {
		.feat,
		.feat-sm {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 600px) {
		.feat,
		.feat-wide {
			padding: 24px;
		}
	}

	/* STATEMENT */
	.statement {
		padding-block: 220px 40px;
	}
	.statement-text {
		max-width: 1700px;
		font-size: clamp(36px, 5.6vw, 104px);
		line-height: 1.06;
		letter-spacing: -0.035em;
	}
	.statement-text span {
		color: var(--ink);
	}
	:global(.js) .statement-text span {
		opacity: 0.16;
	}

	/* QUOTE */
	.quote {
		padding-top: 160px;
	}
	.quote figure {
		margin: 0 auto;
		max-width: 980px;
		text-align: center;
	}
	.quote blockquote {
		margin: 0;
		font-size: clamp(30px, 3.8vw, 50px);
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: -0.025em;
	}
	.quote figcaption {
		margin-top: 32px;
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-size: 15px;
		color: var(--ink-2);
	}
	.rule {
		width: 32px;
		height: 1px;
		background: var(--line-strong);
	}

	/* TUTORIALS */
	#tutorials {
		padding-top: 180px;
	}
	.tutorials {
		display: flex;
		flex-wrap: wrap;
		gap: 48px;
		padding: 64px 48px;
		border-radius: 28px;
	}
	.tut-copy {
		flex: 1 1 340px;
		min-width: 0;
	}
	.tut-title {
		margin-top: 16px;
		font-size: clamp(34px, 4vw, 52px);
		line-height: 1.04;
		letter-spacing: -0.03em;
	}
	.tut-copy .lede {
		margin-top: 18px;
	}
	.link-arrow {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 28px;
		font-weight: 600;
		color: var(--brand);
	}
	.link-arrow svg {
		transition: transform 0.4s var(--ease-out);
	}
	.link-arrow:hover svg {
		transform: translateX(4px);
	}
	.tut-list {
		flex: 1.4 1 420px;
		min-width: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 0 32px;
	}
	.tut-list li {
		border-top: 1px solid var(--line);
	}
	.tut-list a {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 16px 0;
		color: var(--ink);
	}
	.tut-n {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--ink-3);
		transition: color 0.3s ease;
	}
	.tut-l {
		flex: 1;
		font-weight: 500;
		transition: transform 0.45s var(--ease-out);
	}
	.tut-list svg {
		color: var(--ink-3);
		transition: color 0.3s ease, transform 0.45s var(--ease-out);
	}
	.tut-list a:hover .tut-l {
		transform: translateX(6px);
	}
	.tut-list a:hover .tut-n,
	.tut-list a:hover svg {
		color: var(--brand);
	}
	.tut-list a:hover svg {
		transform: scale(1.12);
	}
	@media (max-width: 600px) {
		.tutorials {
			padding: 32px 24px;
		}
	}

	/* FAQ */
	.faq {
		padding-top: 180px;
		display: flex;
		flex-wrap: wrap;
		gap: 48px;
	}
	.faq-head {
		flex: 1 1 320px;
		min-width: 0;
	}
	.faq-head .lede {
		margin-top: 18px;
	}
	.inline-link {
		color: var(--brand);
		font-weight: 500;
	}
	.faq-list {
		flex: 2 1 560px;
		min-width: 0;
	}
	details {
		border-top: 1px solid var(--line);
	}
	details:last-child {
		border-bottom: 1px solid var(--line);
	}
	summary {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		padding: 24px 0;
		font-size: 19px;
		font-weight: 500;
		cursor: pointer;
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	.plus {
		position: relative;
		flex: none;
		width: 14px;
		height: 14px;
		color: var(--ink-3);
	}
	.plus::before,
	.plus::after {
		content: "";
		position: absolute;
		left: 0;
		top: 6px;
