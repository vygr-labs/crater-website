---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import { CHANNEL, DOCS, osIcon, playlists } from "../lib/site";
import { getHref, getRelease, type AssetKey } from "../lib/release";
import Sunday from "../components/sections/Sunday.astro";
import Screens from "../components/sections/Screens.astro";
import Themes from "../components/sections/Themes.astro";
import Keys from "../components/sections/Keys.astro";
import Switch from "../components/sections/Switch.astro";
import Open from "../components/sections/Open.astro";
import Request from "../components/sections/Request.astro";

import heroConsole from "../assets/shots/hero-console.webp";
import projScripture from "../assets/shots/proj-scripture.webp";
import projSong from "../assets/shots/proj-song.webp";
import projSong2 from "../assets/shots/proj-song-2.webp";
import projSongReel from "../assets/shots/proj-song-reel.webp";
import projSongCyan from "../assets/shots/proj-song-cyan.webp";
import consoleScripture from "../assets/shots/console-scripture.webp";
import projSermon from "../assets/shots/proj-sermon.webp";
import projCountdown from "../assets/shots/proj-countdown.webp";
import projStrongs from "../assets/shots/proj-strongs.webp";
import projStage from "../assets/shots/proj-stage.webp";
import consoleThemes from "../assets/shots/console-themes.webp";
import consoleMedia from "../assets/shots/console-media.webp";
import schedule from "../assets/shots/schedule.webp";

const release = await getRelease();
const platforms = [
	{ name: "Windows", icon: osIcon.windows, note: "Installer for Windows 10 and 11", key: "windows" as AssetKey },
	{ name: "macOS", icon: osIcon.mac, note: "Apple silicon and Intel", key: "mac" as AssetKey },
	{ name: "Linux", icon: osIcon.linux, note: "AppImage for x86-64", key: "linux" as AssetKey },
];

const reel = [
	{ img: projSongReel, title: "Songs", note: "Lyrics, verse by verse", alt: "It Is Well with My Soul on the projector" },
	{ img: projScripture, title: "Scripture", note: "Highlight as you preach", alt: "John 3:16 with highlighted words" },
	{ img: projSermon, title: "Sermon slides", note: "Built right in Crater", alt: "A sermon title slide, The Lord Is My Shepherd" },
	{ img: projStrongs, title: "Strong's", note: "The Greek and Hebrew behind a word", alt: "A Strong's definition for agape" },
	{ img: projStage, title: "Stage display", note: "Now, next and your notes", alt: "The stage display with current and next slide" },
	{ img: projCountdown, title: "Countdowns", note: "Start on time", alt: "A countdown before the service" },
];

const marquee = [
	"Scripture",
	"Songs",
	"Sermon slides",
	"Media",
	"Countdowns",
	"Stage display",
	"Strong's",
	"Themes",
	"NDI output",
	"Cast to a TV",
	"Profiles",
	"Keyboard first",
];

const statement = "Built for the laptop already in the booth, and the volunteer who has never run a service before.";

const faqs = [
	[
		"Is Crater really free?",
		"Yes. Free to download and use on as many computers as you like, with no trial and no licence. The code is open source, so it belongs to the community rather than a company.",
	],
	[
		"Will it run on our old church laptop?",
		"Almost certainly. Crater is built to feel quick on modest machines with 4 GB of RAM. If it runs Windows 10, it will very likely run Crater well.",
	],
	[
		"Do our volunteers need to be technical?",
		"No. If you can put together a slideshow you can run a service. The tutorial playlists walk through each task in a few minutes.",
	],
	[
		"Can we send the screen to our live stream?",
		"Yes. Crater sends its output over NDI, which OBS and most streaming tools already understand. No capture card needed.",
	],
	["Is our information private?", "Completely. No accounts, no tracking, no analytics. Your songs and services stay on your computer."],
];
---

<Base
	title="Crater · Free worship projection for churches"
	description="Free, open source worship projection software. Scripture, songs, media and sermon slides on the screen from one calm console. Windows, macOS and Linux."
>
	<main>
		<!-- HERO -->
		<section id="top" class="hero">
			<div class="sun" aria-hidden="true"></div>
			<div class="hero-copy wrap">
				<div class="pill" data-hero-in>
					<span class="pill-tag">Free</span>
					Open source worship projection for Windows, Mac and Linux
				</div>
				<h1 class="display hero-title" aria-label="Put the Word on the wall.">
					<span class="line"><span class="w">Put</span> <span class="w">the</span> <span class="w"><span class="hl" data-hl>Word</span></span></span>
					<span class="line"><span class="w">on</span> <span class="w">the</span> <span class="w">wall.</span></span>
				</h1>
				<p class="hero-lede lede" data-hero-in>
					Scripture, songs, media and sermon slides on the screen from one calm console. Free for every church, light enough for the laptop already in
					the booth.
				</p>
				<div class="hero-ctas" data-hero-in>
					<a href="#download" class="btn btn-brand" data-magnetic>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg>
						Download for free
					</a>
					<a href={playlists[0].url} target="_blank" rel="noopener" class="btn btn-ghost" data-magnetic>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M10 8.5v7l6-3.5-6-3.5Z"></path></svg>
						Watch the tour
					</a>
				</div>
				<p class="hero-note" data-hero-in>No account. No trial. Nothing leaves the building.</p>
			</div>

			<div class="stage wrap">
				<div class="arc" aria-hidden="true"></div>
				<div class="screen" data-screen>
					<Image src={heroConsole} alt="The Crater console with Amazing Grace live, the next verse lined up, and the song library below" widths={[960, 1440, 1920]} sizes="96vw" loading="eager" fetchpriority="high" />
					<div class="screen-sheen" aria-hidden="true"></div>
				</div>
				<div class="float-proj" data-float>
					<Image src={projSong} alt="The projector showing the first verse of Amazing Grace" widths={[480, 800]} sizes="34vw" loading="eager" />
					<span class="live-badge"><span class="dot"></span>LIVE</span>
				</div>
			</div>
		</section>

		<!-- MARQUEE -->
		<section class="marquee" aria-label="What Crater does">
			<div class="marquee-track" data-marquee>
				{
					[0, 1].map((copy) => (
						<ul aria-hidden={copy === 1 ? "true" : undefined}>
							{marquee.map((m) => (
								<li>
									<span class="sep" aria-hidden="true"><Mark size={24} /></span>
									{m}
								</li>
							))}
						</ul>
					))
				}
			</div>
		</section>

		<!-- FACTS -->
		<section class="facts wrap" aria-label="At a glance">
			<div class="fact" data-reveal="up">
				<span class="fact-n">Free</span>
				<span class="fact-l">On every machine, for good</span>
			</div>
			<div class="fact" data-reveal="up">
				<span class="fact-n"><span data-count="14">14</span></span>
				<span class="fact-l">Bible translations included</span>
			</div>
			<div class="fact" data-reveal="up">
				<span class="fact-n"><span data-count="4">4</span> GB</span>
				<span class="fact-l">Of RAM is all it needs</span>
			</div>
			<div class="fact" data-reveal="up">
				<span class="fact-n"><span data-count="3">3</span></span>
				<span class="fact-l">Windows, macOS and Linux</span>
			</div>
		</section>

		<!-- WHAT THE ROOM SEES: pinned horizontal reel -->
		<section id="room" class="room" data-reel>
			<div class="room-pin">
				<div class="wrap room-head">
					<div>
						<p class="eyebrow" data-reveal="up">What the room sees</p>
						<h2 class="display h2" data-reveal="up">Every slide, <span class="hl" data-hl>beautifully</span> set.</h2>
					</div>
					<p class="lede room-note" data-reveal="up">Real output from Crater, straight off the projector. No mockups, no retouching.</p>
				</div>
				<div class="reel" data-reel-track>
					{
						reel.map((r, i) => (
							<figure class="reel-item">
								<div class="reel-frame">
									<Image src={r.img} alt={r.alt} widths={[640, 1280]} sizes="(max-width: 800px) 86vw, 52vw" />
								</div>
								<figcaption>
									<span class="reel-n">{String(i + 1).padStart(2, "0")}</span>
									<span class="reel-t">{r.title}</span>
									<span class="reel-d">{r.note}</span>
								</figcaption>
							</figure>
						))
					}
				</div>
				<div class="wrap reel-progress" aria-hidden="true">
					<div class="rp">
						<span class="rp-fill" data-reel-bar></span>
						{
							reel.map((r, i) => (
								<span class="rp-step" data-reel-step style={`--at: ${(i / (reel.length - 1)) * 100}%`}>
									<i></i>
									<span>{r.title}</span>
								</span>
							))
						}
						<span class="rp-head" data-reel-head></span>
					</div>
				</div>
			</div>
		</section>

		<!-- FEATURES -->
		<section id="features" class="features wrap">
			<div class="section-head center">
				<p class="eyebrow" data-reveal="up">Everything a service needs</p>
				<h2 class="display h2" data-reveal="up">Plan in the week. <span class="hl" data-hl>Breathe</span> on Sunday.</h2>
			</div>

			<div class="grid">
				<article class="card feat feat-wide" data-feat data-spot>
					<div class="feat-copy">
						<h3>Find any verse as you type.</h3>
						<p class="lede">
							Type a reference, or a few words you remember. Crater reads "jn 3 16" and "for god so loved" the same way, across every translation you have.
							Strong's numbers are one tab away.
						</p>
						<div class="chips">
							<span class="chip">Instant search</span>
							<span class="chip">Many translations</span>
							<span class="chip">Strong's</span>
						</div>
					</div>
					<div class="feat-shot" data-parallax-box>
						<Image src={consoleScripture} alt="Scripture search results for John 3 16" widths={[800, 1280]} sizes="(max-width: 900px) 100vw, 62vw" data-parallax />
					</div>
				</article>

				<article class="card feat" data-feat data-spot>
					<div>
						<h3>Themes you set once.</h3>
						<p class="lede">Fonts, colours and backgrounds with a live preview. Save it, reuse it every week, share it in one file.</p>
					</div>
					<div class="feat-shot" data-parallax-box>
						<Image src={consoleThemes} alt="The theme editor" widths={[640, 1200]} sizes="(max-width: 1060px) 100vw, 48vw" data-parallax />
					</div>
				</article>

				<article class="card feat" data-feat data-spot>
					<div>
						<h3>Media and countdowns.</h3>
						<p class="lede">Videos, images and timers sit in the same schedule as your songs. Loop a background, count the room in.</p>
					</div>
					<div class="feat-shot" data-parallax-box>
						<Image src={consoleMedia} alt="The media library with a countdown in preview and live" widths={[640, 1200]} sizes="(max-width: 900px) 100vw, 600px" data-parallax />
					</div>
				</article>

				<!-- Preview and live: the next slide waits in gold, then takes the wall. -->
				<article class="card feat feat-sm" data-feat data-spot>
					<div class="golive" data-golive aria-label="A slide waiting in preview, then going live" role="img">
						<div class="gl-pane gl-preview">
							<span class="tag tag-gold">PREVIEW</span>
							<div class="gl-slot">
								<Image src={projSong2} alt="" widths={[480]} sizes="200px" data-gl-a />
								<Image src={projScripture} alt="" widths={[480]} sizes="200px" data-gl-b />
							</div>
						</div>
						<div class="gl-arrow" aria-hidden="true">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
						</div>
						<div class="gl-pane gl-live">
							<span class="tag tag-live"><span class="dot"></span>LIVE</span>
							<div class="gl-slot">
								<Image src={projSong} alt="" widths={[480]} sizes="200px" data-gl-live />
							</div>
						</div>
					</div>
					<h3>See it before the room does.</h3>
					<p class="lede">Line up the next slide in gold while the room watches red. One key sends it.</p>
				</article>

				<!-- Stream: the live output arriving in a broadcast monitor over NDI. -->
				<article class="card feat feat-sm" data-feat data-spot>
					<div class="monitor" aria-label="Crater's live output arriving in a stream over NDI" role="img">
						<div class="mon-bar">
							<span class="mon-rec"><span class="dot"></span>REC</span>
							<span class="mon-src">NDI · CRATER</span>
							<span class="mon-meter" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
						</div>
						<div class="mon-screen">
							<Image src={projSongCyan} alt="" widths={[640]} sizes="320px" />
							<span class="mon-scan" aria-hidden="true"></span>
						</div>
					</div>
					<h3>Straight into your stream.</h3>
					<p class="lede">Send the screen to OBS over NDI. No capture card, no second laptop.</p>
				</article>

				<!-- Order of service: the real schedule panel. -->
				<article class="card feat feat-sm" data-feat data-spot>
					<div class="sched" data-parallax-box>
						<Image src={schedule} alt="The schedule with songs, a reading, sermon slides and a video in order" widths={[480, 800]} sizes="(max-width: 900px) 100vw, 400px" data-parallax />
					</div>
					<h3>The whole order of service.</h3>
					<p class="lede">Songs, readings, slides and videos in one list. Drag to reorder, it saves as you go.</p>
				</article>
			</div>
		</section>

		<Sunday />

		<!-- STATEMENT: words light up as you scroll -->
		<section class="statement wrap" aria-label={statement}>
			<p class="display statement-text" data-scrub-words aria-hidden="true">
				{statement.split(" ").map((w) => <span>{w} </span>)}
			</p>
		</section>

		<Screens />
		<Themes />
		<Keys />
		<Switch />

		<!-- QUOTE -->
		<section class="quote wrap">
			<figure data-reveal="up">
				<blockquote class="display">"Let the word of Christ dwell in you richly in all wisdom; teaching and admonishing one another in psalms and hymns and spiritual songs."</blockquote>
				<figcaption><span class="rule"></span>Colossians 3:16</figcaption>
			</figure>
		</section>

		<!-- TUTORIALS -->
		<section id="tutorials" class="wrap">
			<div class="card tutorials" data-reveal="card">
				<div class="tut-copy">
					<p class="eyebrow">Learn it in an afternoon</p>
					<h2 class="display tut-title">Short videos for <span class="hl" data-hl>every</span> volunteer.</h2>
					<p class="lede">Each one covers a single task in a few minutes. Hand the playlist to whoever runs the booth this week.</p>
					<a href={CHANNEL} target="_blank" rel="noopener" class="link-arrow">
						Open the channel
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
					</a>
				</div>
				<ol class="tut-list">
					{
						playlists.map((p) => (
							<li data-reveal="row">
								<a href={p.url} target="_blank" rel="noopener">
									<span class="tut-n">{p.n}</span>
									<span class="tut-l">{p.label}</span>
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<circle cx="12" cy="12" r="10" />
										<path d="M10 8.5v7l6-3.5-6-3.5Z" />
									</svg>
								</a>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<Open />
		<Request />

		<!-- FAQ -->
		<section id="faq" class="faq wrap">
			<div class="faq-head">
				<h2 class="display h2" data-reveal="up">Good <span class="hl" data-hl>questions</span>.</h2>
				<p class="lede" data-reveal="up">Something else on your mind? <a href={DOCS} target="_blank" rel="noopener" class="inline-link u-link">Read the docs</a> or ask on GitHub.</p>
			</div>
			<div class="faq-list">
				{
					faqs.map(([q, a]) => (
						<details data-reveal="row">
							<summary>
								{q}
								<span class="plus" aria-hidden="true" />
							</summary>
							<div class="faq-a">
								<p class="lede">{a}</p>
							</div>
						</details>
					))
				}
			</div>
		</section>

		<!-- DOWNLOAD -->
		<section id="download" class="download">
			<div class="sun sun-2" aria-hidden="true" data-sun-2></div>
			<div class="wrap download-inner">
				<div data-reveal="up"><Mark size={56} /></div>
				<h2 class="display download-title" data-reveal="up">Ready for <span class="hl" data-hl>Sunday</span>.</h2>
				<p class="lede" data-reveal="up">Pick your computer, run the installer, open your first service. That is the whole setup.</p>
				<div class="platforms">
					{
						platforms.map((p) => (
							<a href={getHref(p.key)} class="platform" data-reveal="card" data-spot>
								<Fragment set:html={p.icon} />
								<span class="p-name">{p.name}</span>
								<span class="p-note">
									{p.note}
									{release.assets[p.key] && (
										<>
											{" · "}
											<span data-rel-size={p.key}>{release.assets[p.key]!.size}</span>
										</>
									)}
								</span>
							</a>
						))
					}
				</div>
				<p class="dl-note" data-reveal="up">
					{
						release.version && (
							<>
								<span data-rel="version">{release.version}</span>
								{" · "}
							</>
						)
					}
					<a href="/download" class="u-link">Other downloads and install help</a>
				</p>
			</div>
		</section>
	</main>

</Base>

<style>
	/* HERO */
	.hero {
		position: relative;
		padding-top: 168px;
		text-align: center;
	}
	.sun {
		position: absolute;
		left: 50%;
		top: 560px;
		width: 1500px;
		height: 1500px;
		margin-left: -750px;
		border-radius: 50%;
		background: radial-gradient(closest-side, var(--glow), transparent 72%);
		pointer-events: none;
		will-change: transform, opacity;
	}
	/* Hangs off the console rather than the page top, so the copy above
	   can grow with the window without the line running through it. */
	.arc {
		position: absolute;
		left: 50%;
		top: -56px;
		width: 1240px;
		height: 1240px;
		margin-left: -620px;
		border-radius: 50%;
		border-top: 1px solid var(--arc);
		pointer-events: none;
		mask-image: linear-gradient(90deg, transparent, #000 30%, #000 70%, transparent);
	}
	.hero-copy {
		position: relative;
		max-width: 1000px;
	}
	.pill {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 7px 14px 7px 8px;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--card);
		font-size: 14px;
		color: var(--ink-2);
	}
	.pill-tag {
		padding: 3px 10px;
		border-radius: 999px;
		background: var(--brand-wash);
		color: var(--brand);
		font-weight: 600;
		font-size: 12px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.hero-title {
		margin-top: 32px;
		font-size: clamp(48px, 6.4vw, 100px);
		line-height: 0.98;
	}
	.hero-title .line {
		display: block;
	}
	.hero-title .w {
		display: inline-block;
		overflow: clip;
		overflow-clip-margin: 0.12em;
		padding-bottom: 0.06em;
		vertical-align: top;
	}
	.hero-lede {
		margin: 28px auto 0;
		max-width: 620px;
		font-size: 19px;
	}
	.hero-ctas {
		display: flex;
		gap: 12px;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 40px;
	}
	.hero-note {
		margin: 18px 0 0;
		font-size: 14px;
		color: var(--ink-3);
	}
	.stage {
		position: relative;
		max-width: 1240px;
		margin: 80px auto 0;
		perspective: 1800px;
	}
	.screen {
		position: relative;
		border-radius: 18px;
		padding: 10px;
		background: var(--frame);
		border: 1px solid var(--line-strong);
		box-shadow:
			0 40px 120px -20px var(--shadow),
			0 0 0 1px var(--line);
		transform-origin: 50% 0%;
		will-change: transform;
	}
	.screen :global(img) {
		width: 100%;
		border-radius: 10px;
	}
	.screen-sheen {
		position: absolute;
		inset: 10px;
		border-radius: 10px;
		background: linear-gradient(115deg, transparent 35%, rgb(255 255 255 / 0.07) 50%, transparent 65%);
		background-size: 250% 100%;
		background-position: 120% 0;
		pointer-events: none;
	}
	.float-proj {
		position: absolute;
		right: -4px;
		bottom: -56px;
		width: 34%;
		min-width: 200px;
		border-radius: 14px;
		padding: 6px;
		background: var(--frame);
		border: 1px solid var(--line-strong);
		box-shadow: 0 30px 80px -10px var(--shadow);
		will-change: transform;
	}
	.float-proj :global(img) {
		border-radius: 9px;
	}
	.live-badge {
		position: absolute;
		left: 18px;
		top: 18px;
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 4px 10px;
		border-radius: 6px;
		background: #c9372c;
		color: #fff;
		font-family: var(--font-body);
		font-variant-numeric: tabular-nums;
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.08em;
	}
	.dot {
