---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { ISSUES } from "../lib/site";

const areas = ["Songs", "Scripture", "Media", "Sermon slides", "Schedule", "Screens and stage", "Streaming", "Themes", "Something else"];
const open = `${ISSUES}?q=is%3Aissue+is%3Aopen+label%3Aenhancement`;
---

<Base title="Request a feature · Crater" description="Tell the people building Crater what your church needs next.">
	<main>
		<PageHead lede="Every church runs its Sunday a little differently. If Crater is missing something you need, say so here.">
			Missing something? <span class="hl" data-hl>Ask for it</span>.
		</PageHead>

		<section class="wrap rqp">
			<form class="card rqf" data-rqf data-reveal="card" action={`${ISSUES}/new`} method="get" target="_blank">
				<input type="hidden" name="labels" value="enhancement" />
				<label class="rqf-field">
					<span class="rqf-label">What would help?</span>
					<span class="rqf-hint">One idea per request. Say what you want Crater to do, not how.</span>
					<textarea name="title" rows="3" required maxlength="200" placeholder="Import songs from ProPresenter, the way EasyWorship songs come across." data-rqf-what></textarea>
				</label>

				<fieldset class="rqf-field">
					<legend class="rqf-label">Which part of Crater?</legend>
					<div class="rqf-chips">
						{
							areas.map((a, i) => (
								<label class="rqf-chip">
									<input type="radio" name="area" value={a} checked={i === areas.length - 1} />
									<span>{a}</span>
								</label>
							))
						}
					</div>
				</fieldset>

				<label class="rqf-field">
					<span class="rqf-label">How would your church use it? <em>Optional</em></span>
					<span class="rqf-hint">A moment from a real service helps most. What happened, and what you had to do instead.</span>
					<textarea name="why" rows="5" placeholder="Our worship team plans in ProPresenter at home, and we retype every song on Saturday night." data-rqf-why></textarea>
				</label>

				<label class="rqf-field">
					<span class="rqf-label">Church or name <em>Optional</em></span>
					<input type="text" name="who" maxlength="120" data-rqf-who />
				</label>

				<input type="hidden" name="body" data-rqf-body />

				<div class="rqf-foot">
					<p class="rqf-note">
						You'll finish on GitHub, where every request is public and anyone can add to it. It needs a free account.
					</p>
					<button type="submit" class="btn btn-brand" data-magnetic>
						Continue on GitHub
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
					</button>
				</div>
			</form>

			<aside class="rqp-side">
				<div data-reveal="up">
					<h2>Before you ask</h2>
					<p>Someone may have asked already. Add a thumbs up or a comment to an <a href={open} target="_blank" rel="noopener" class="u-link">open request</a> and it counts for more.</p>
				</div>
				<div data-reveal="up">
					<h2>What happens next</h2>
					<p>Requests go straight to the people building Crater. The ones that would help the most churches move up the list.</p>
				</div>
				<div data-reveal="up">
					<h2>Found a bug instead?</h2>
					<p>Report it on <a href={`${ISSUES}/new?labels=bug`} target="_blank" rel="noopener" class="u-link">GitHub</a>. Your log from Settings, then Diagnostics, helps us find it fast.</p>
				</div>
			</aside>
		</section>
	</main>
</Base>

<script>
	// Fold the extra fields into the issue body before GitHub opens.
	const form = document.querySelector<HTMLFormElement>("[data-rqf]");
	if (form) {
		const body = form.querySelector<HTMLInputElement>("[data-rqf-body]")!;
		const what = form.querySelector<HTMLTextAreaElement>("[data-rqf-what]")!;
		const why = form.querySelector<HTMLTextAreaElement>("[data-rqf-why]")!;
		const who = form.querySelector<HTMLInputElement>("[data-rqf-who]")!;
		form.addEventListener("submit", () => {
			const area = new FormData(form).get("area");
			body.value = [
				`**Part of Crater:** ${area}`,
				"",
				"**What would help**",
				what.value.trim(),
				why.value.trim() && `\n**How we'd use it**\n${why.value.trim()}`,
				who.value.trim() && `\n_From ${who.value.trim()}_`,
				"\n_Sent from the request page on the Crater website._",
			]
				.filter((l) => l !== "")
				.join("\n");
			// The extra fields aren't GitHub parameters, so keep them out of the URL.
			for (const el of [why, who]) el.disabled = true;
			form.querySelectorAll<HTMLInputElement>('[name="area"]').forEach((r) => (r.disabled = true));
			setTimeout(() => {
				for (const el of [why, who]) el.disabled = false;
				form.querySelectorAll<HTMLInputElement>('[name="area"]').forEach((r) => (r.disabled = false));
			});
		});
	}
</script>

<style>
	.rqp {
		margin-top: 80px;
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
		gap: clamp(32px, 5vw, 80px);
		align-items: start;
	}
	.rqf {
		display: grid;
		gap: 30px;
		padding: clamp(24px, 4vw, 48px);
	}
	.rqf-field {
		display: grid;
		gap: 8px;
		margin: 0;
		padding: 0;
		border: 0;
		min-width: 0;
	}
	.rqf-label {
		padding: 0;
		font-size: 15px;
		font-weight: 600;
	}
	.rqf-label em {
		margin-left: 6px;
		font-style: normal;
		font-weight: 400;
		color: var(--ink-3);
	}
	.rqf-hint {
		font-size: 14px;
		color: var(--ink-3);
	}
	textarea,
	input[type="text"] {
		width: 100%;
		margin-top: 4px;
		padding: 14px 16px;
		border-radius: 12px;
		border: 1px solid var(--line-strong);
		background: var(--bg-2);
		color: var(--ink);
		font: inherit;
		font-size: 16px;
		line-height: 1.5;
		resize: vertical;
		transition:
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}
	textarea::placeholder {
		color: var(--ink-3);
	}
	textarea:focus,
	input[type="text"]:focus {
		outline: none;
		border-color: var(--brand);
		box-shadow: 0 0 0 4px var(--brand-wash);
	}
	.rqf-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 12px;
	}
	.rqf-chip input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.rqf-chip span {
		display: inline-block;
		padding: 8px 14px;
		border-radius: 999px;
		border: 1px solid var(--line);
		font-size: 14px;
		color: var(--ink-2);
		cursor: pointer;
		transition:
			border-color 0.25s ease,
			background-color 0.25s ease,
			color 0.25s ease;
	}
	.rqf-chip span:hover {
		border-color: var(--line-strong);
		color: var(--ink);
	}
	.rqf-chip input:checked + span {
		border-color: var(--brand);
		background: var(--brand-wash);
		color: var(--brand);
	}
	.rqf-chip input:focus-visible + span {
		outline: 2px solid var(--brand);
		outline-offset: 2px;
	}
	.rqf-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		padding-top: 26px;
		border-top: 1px solid var(--line);
	}
	.rqf-note {
		flex: 1 1 260px;
		margin: 0;
		font-size: 14px;
		line-height: 1.5;
		color: var(--ink-3);
	}
	.rqp-side {
		display: grid;
		gap: 36px;
		padding-top: 12px;
	}
	.rqp-side h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 20px;
		font-weight: 600;
	}
	.rqp-side p {
		margin: 10px 0 0;
		font-size: 15px;
		line-height: 1.6;
		color: var(--ink-2);
	}
	@media (max-width: 900px) {
		.rqp {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
