---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { ISSUES } from "../lib/site";
import "../styles/forms.css";

const areas = ["Songs", "Scripture", "Media", "Sermon slides", "Schedule", "Screens and stage", "Streaming", "Themes", "Something else"];
const open = `${ISSUES}?q=is%3Aissue+is%3Aopen+label%3Aenhancement`;
---

<Base title="Request a feature · Crater" description="Tell the people building Crater what your church needs next.">
	<main>
		<PageHead lede="Every church runs its Sunday a little differently. If Crater is missing something you need, say so here.">
			Missing something? <span class="hl" data-hl>Ask for it</span>.
		</PageHead>

		<section class="wrap fpage">
			<div class="card fcard" data-report-card data-reveal="card">
				<form class="fform" action="/api/report" method="post" data-report-form>
					<input type="hidden" name="kind" value="feature" />
					<input type="hidden" name="t" value="" />
					<label class="ftrap" aria-hidden="true">Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>

					<label class="ffield">
						<span class="flabel">What would help?</span>
						<span class="fhint">One idea per request. Say what you want Crater to do, not how.</span>
						<textarea name="what" rows="3" required minlength="4" maxlength="200" placeholder="Import songs from ProPresenter, the way EasyWorship songs come across."></textarea>
					</label>

					<fieldset class="ffield">
						<legend class="flabel">Which part of Crater?</legend>
						<div class="fchips">
							{
								areas.map((a, i) => (
									<label class="fchip">
										<input type="radio" name="area" value={a} checked={i === areas.length - 1} />
										<span>{a}</span>
									</label>
								))
							}
						</div>
					</fieldset>

					<label class="ffield">
						<span class="flabel">How would your church use it? <em>Optional</em></span>
						<span class="fhint">A moment from a real service helps most. What happened, and what you had to do instead.</span>
						<textarea name="why" rows="5" maxlength="4000" placeholder="Our worship team plans in ProPresenter at home, and we retype every song on Saturday night."></textarea>
					</label>

					<div class="frow">
						<label class="ffield">
							<span class="flabel">Church or name <em>Optional</em></span>
							<span class="fhint">Shown on the request.</span>
							<input type="text" name="name" maxlength="120" autocomplete="organization" />
						</label>
						<label class="ffield">
							<span class="flabel">Email <em>Optional</em></span>
							<span class="fhint">Only so we can ask a question. Never shown.</span>
							<input type="email" name="email" maxlength="200" autocomplete="email" />
						</label>
					</div>

					<p class="ferror" role="alert" data-report-error hidden></p>

					<div class="ffoot">
						<p class="fnote">Requests are posted publicly on <a href={open} target="_blank" rel="noopener" class="u-link">GitHub</a> so other churches can add to them. No account needed.</p>
						<button type="submit" class="btn btn-brand" data-magnetic>
							Send request
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
						</button>
					</div>
				</form>

				<div class="fdone" data-report-done hidden>
					<span class="fdone-mark" aria-hidden="true">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"></path></svg>
					</span>
					<h2 tabindex="-1">Thank you. It's sent.</h2>
					<p>Your request is with the people building Crater. If you left an email, we may write to ask a question.</p>
					<div class="fdone-row">
						<a href="#" class="btn btn-ghost" target="_blank" rel="noopener" data-report-issue hidden>See it on GitHub</a>
						<a href="/request" class="btn btn-ghost">Send another</a>
					</div>
				</div>
			</div>

			<aside class="fside">
				<div data-reveal="up">
					<h2>Before you ask</h2>
					<p>Someone may have asked already. Add a thumbs up or a comment to an <a href={open} target="_blank" rel="noopener" class="u-link">open request</a> and it counts for more.</p>
				</div>
				<div data-reveal="up">
					<h2>What happens next</h2>
					<p>Requests go straight to the people building Crater. The ones that would help the most churches move up the list.</p>
				</div>
				<div data-reveal="up">
					<h2>Found a bug instead?</h2>
					<p><a href="/report" class="u-link">Report it here</a>. A few lines about what went wrong help us fix it fast.</p>
				</div>
			</aside>
		</section>
	</main>
</Base>

<script>
	import "../scripts/report-form.ts";
</script>
