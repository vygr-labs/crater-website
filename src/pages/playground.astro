---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import { TRANSLATIONS } from "../scripts/playground/bible";
import "../styles/playground.css";

const title = "Projection practice: a free church projection simulator · Crater";
const description =
	"Practise running church projection in your browser. Put Bible verses and hymns on a pretend projector, follow timed cues from a real service and track how fast you get.";

const ld = {
	"@context": "https://schema.org",
	"@type": "WebApplication",
	name: "Crater projection practice",
	url: "https://getcrater.org/playground",
	applicationCategory: "EducationalApplication",
	operatingSystem: "Any",
	browserRequirements: "A modern web browser",
	isAccessibleForFree: true,
	offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
	description,
};

const icons = {
	clear: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18M10.6 5.1A9.8 9.8 0 0 1 12 5c5 0 9 4.5 10 7a12 12 0 0 1-3 4M6.6 6.6C4 8.1 2.6 10.6 2 12c1 2.5 5 7 10 7 1.7 0 3.2-.5 4.6-1.2"></path></svg>`,
	logo: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="2"></circle><path d="m21 16-5-5-8 9"></path></svg>`,
	eye: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg>`,
	book: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5a2 2 0 0 1 2-2h5a2 2 0 0 1 2 2v16a2 2 0 0 0-2-2H3ZM21 5a2 2 0 0 0-2-2h-5a2 2 0 0 0-2 2v16a2 2 0 0 1 2-2h7Z"></path></svg>`,
	music: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>`,
	full: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="i-open" d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path><path class="i-shut" d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5"></path></svg>`,
	search: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>`,
};
---

<Base title={title} description={description}>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
	<main>
		<header class="wrap pg-head">
			<h1 class="display pg-title">Practise projection before Sunday.</h1>
			<p class="lede pg-lede">
				A pretend Crater console with a projector. Run timed drills from a real service, or just play. Nothing to install, and your progress stays on this device.
			</p>
		</header>

		<section class="wrap pg" data-pg aria-label="Practice console">
			<div class="pg-app">
				<div class="pg-stage">
					<figure class="screen">
						<div class="wall" data-wall aria-live="polite">
							<div class="wall-content" data-wall-content></div>
							<div class="wall-logo" aria-hidden="true">
								<Mark size={64} />
								<span>Welcome</span>
							</div>
						</div>
						<figcaption class="screen-cap"><span class="dot"></span>Projector</figcaption>
						<button type="button" class="screen-full" data-act="full" aria-pressed="false" aria-label="Full screen"><Fragment set:html={icons.full} /></button>
					</figure>
					<div class="coach" data-coach aria-live="polite"></div>
				</div>

				<div class="console" data-console data-show="library">
					<div class="c-bar">
						<span class="c-title">Practice console</span>
						<div class="c-bar-end">
							<button type="button" class="c-btn" data-act="logo" aria-pressed="false" title="Logo (Ctrl + L)"><Fragment set:html={icons.logo} /><span>Logo</span></button>
							<button type="button" class="c-btn" data-act="clear" aria-pressed="false" title="Clear (Ctrl + .)"><Fragment set:html={icons.clear} /><span>Clear</span></button>
							<button type="button" class="c-btn c-full" data-act="full" aria-pressed="false" title="Full screen (F)"><Fragment set:html={icons.full} /><span>Full screen</span></button>
						</div>
					</div>

					<div class="c-views" role="tablist" aria-label="Panels">
						<button type="button" role="tab" data-view="library">Library</button>
						<button type="button" role="tab" data-view="preview">Preview</button>
						<button type="button" role="tab" data-view="live"><span class="c-live-dot"></span>Live</button>
					</div>

					<div class="c-grid">
						<section class="zone z-preview" data-zone="preview" aria-label="Preview">
							<header class="z-head">
								<span class="z-name"><Fragment set:html={icons.eye} />Preview</span>
								<span class="z-count" data-preview-count></span>
								<button type="button" class="z-go" data-act="golive">Go live</button>
							</header>
							<div class="z-list" data-preview-list data-lenis-prevent></div>
						</section>

						<section class="zone z-live" data-zone="live" aria-label="Live">
							<header class="z-head">
								<span class="z-name"><span class="live-tag">Live</span></span>
								<span class="z-count" data-live-count></span>
							</header>
							<div class="z-list" data-live-list data-lenis-prevent></div>
						</section>

						<section class="zone z-lib" data-zone="library" aria-label="Library">
							<div class="lib-tabs" role="tablist">
								<button type="button" role="tab" data-lib-tab="songs"><Fragment set:html={icons.music} />Songs</button>
								<button type="button" role="tab" data-lib-tab="scripture"><Fragment set:html={icons.book} />Scripture</button>
							</div>

							<div class="lib" data-lib="scripture">
								<div class="lib-side">
									<label class="lib-search">
										<Fragment set:html={icons.search} />
										<input type="search" data-q placeholder="jn 3:16 or words" aria-label="Find a verse" autocomplete="off" spellcheck="false" enterkeyhint="go" />
									</label>
									<p class="lib-interp" data-interp></p>
									<div class="lib-trans" role="group" aria-label="Translation">
										{
											TRANSLATIONS.map((t, i) => (
												<button type="button" data-trans={t.id} aria-pressed={i === 0 ? "true" : "false"} title={t.name}>
													{t.id}
												</button>
											))
										}
									</div>
								</div>
								<div class="lib-main">
									<p class="lib-count" data-count></p>
									<div class="z-list rows" data-rows data-lenis-prevent></div>
								</div>
							</div>

							<div class="lib" data-lib="songs" hidden>
								<div class="lib-side">
									<label class="lib-search">
										<Fragment set:html={icons.search} />
										<input type="search" data-sq placeholder="Title or a line" aria-label="Find a song" autocomplete="off" spellcheck="false" />
									</label>
									<p class="lib-interp">Hymns in the public domain.</p>
								</div>
								<div class="lib-main">
									<div class="z-list rows" data-song-rows data-lenis-prevent></div>
								</div>
							</div>
						</section>
					</div>

					<div class="c-dock">
						<button type="button" class="d-btn" data-act="clear" aria-pressed="false"><Fragment set:html={icons.clear} /><span>Clear</span></button>
						<button type="button" class="d-btn" data-act="logo" aria-pressed="false"><Fragment set:html={icons.logo} /><span>Logo</span></button>
						<span class="d-step">
							<button type="button" class="d-btn" data-act="prev" aria-label="Previous live slide">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"></path></svg>
							</button>
							<button type="button" class="d-btn" data-act="next" aria-label="Next live slide">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
							</button>
						</span>
						<button type="button" class="d-go" data-act="golive">Go live</button>
					</div>

					<div class="overlay" data-overlay hidden data-lenis-prevent></div>
				</div>
			</div>

			<p class="pg-keys">
				<span><kbd>Enter</kbd> send live</span>
				<span><kbd>↑</kbd><kbd>↓</kbd> move in the panel you clicked</span>
				<span><kbd>Ctrl</kbd><kbd>.</kbd> clear</span>
				<span><kbd>Ctrl</kbd><kbd>L</kbd> logo</span>
				<span><kbd>/</kbd> find a verse</span>
				<span><kbd>F</kbd> full screen</span>
			</p>
		</section>

		<section class="wrap pg-stats" id="progress" data-stats aria-labelledby="progress-h">
			<h2 class="display h2" id="progress-h">Your progress</h2>
			<div data-stats-body></div>
		</section>

		<section class="wrap pg-about">
			<div class="pg-about-grid">
				<div>
					<h2 class="display h2">Why practise at all?</h2>
					<p class="lede">
						Most projection mistakes happen in the first few weeks: the wrong verse goes up, the chorus comes in late, or the words stay on the screen through the prayer. A few minutes here gets those habits right before you are in the booth with a full room watching.
					</p>
				</div>
				<dl class="pg-faq">
					<div>
						<dt>Is this the real Crater?</dt>
						<dd>It is a small copy of Crater's live controls: the library, Preview, Live, Clear and Logo, with the same keys. <a href="/download" class="u-link">Crater itself</a> is free and adds songs you write, media, themes, schedules and more screens.</dd>
					</div>
					<div>
						<dt>Which Bibles and songs are here?</dt>
						<dd>The King James Version and the World English Bible, both in the public domain, and five well known hymns.</dd>
					</div>
					<div>
						<dt>Where are my results kept?</dt>
						<dd>In this browser only. There is no account and nothing is sent anywhere. Clearing your browser data, or the button under your progress, removes them.</dd>
					</div>
					<div>
						<dt>Does it work on a phone?</dt>
						<dd>Yes. Switch between Library, Preview and Live with the tabs, and use Go live, Clear and Logo along the bottom.</dd>
					</div>
					<div>
						<dt>I want to train a whole team.</dt>
						<dd>Send them this page. The <a href="/docs/guides/displaying-content" class="u-link">Running a Service guide</a> and the <a href="/tutorials" class="u-link">video tutorials</a> cover the rest.</dd>
					</div>
				</dl>
			</div>
		</section>
	</main>
</Base>

<script>
	import "../scripts/playground/app.ts";
</script>
