---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Switch from "../components/sections/Switch.astro";
import { DOCS } from "../lib/site";

import consoleScripture from "../assets/shots/console-scripture.webp";
import projStrongs from "../assets/shots/proj-strongs.webp";
import projSongReel from "../assets/shots/proj-song-reel.webp";
import consoleMedia from "../assets/shots/console-media.webp";
import projSermon from "../assets/shots/proj-sermon.webp";
import schedule from "../assets/shots/schedule.webp";
import projStage from "../assets/shots/proj-stage.webp";
import projSongCyan from "../assets/shots/proj-song-cyan.webp";
import consoleThemes from "../assets/shots/console-themes.webp";
import projCountdown from "../assets/shots/proj-countdown.webp";

// Every line here comes from the documentation, so it holds for the
// current release. Docs paths are relative to the docs site.
const areas = [
	{
		id: "scripture",
		title: "Scripture",
		lede: "Find any verse in seconds, whether you know the reference or only remember a few words.",
		img: consoleScripture,
		alt: "Scripture search results for John 3 16",
		points: [
			"Fourteen English translations included: AMPC, ASV, CEV, ESV, GNT, KJV, MSG, NASB2020, NIV, NKJV, NLT, RSV, TLV and TPT.",
			'Type "jn 3 16", "1 cor 13 4" or "ps 23" and Crater goes straight there. Small spelling mistakes are fine.',
			"Search by the words you remember when the reference slips your mind.",
			'Ranges like "John 3:16-18" select together, and "jn 3:16 niv" switches translation as you type.',
		],
		docs: "features/scriptures/",
	},
	{
		id: "strongs",
		title: "Strong's",
		lede: "Word studies without leaving the console.",
		img: projStrongs,
		alt: "A Strong's definition for agape on the projector",
		points: [
			"All 14,700 Strong's entries, Hebrew and Greek, with the original word, transliteration and definition.",
			"A King James reader with each tagged word linked to its number.",
			"Put a definition on the screen when the sermon turns on a word.",
		],
		docs: "features/strongs/",
	},
	{
		id: "songs",
		title: "Songs",
		lede: "Your church's song library, ready verse by verse.",
		img: projSongReel,
		alt: "It Is Well with My Soul on the projector",
		points: [
			"Each section of a song is its own slide, labelled with its name, so a repeated chorus is one click away.",
			"Favourites and collections keep this season's songs close.",
			"Bold, italic, underline and colour on any words in a lyric.",
			"Change a song for one service only and the library copy stays as it was.",
			"Bring your songs across from EasyWorship 6 and 7, with authors, copyright and CCLI numbers.",
		],
		docs: "features/songs/",
	},
	{
		id: "media",
		title: "Media",
		lede: "Announcement slides, countdown videos, sermon illustrations and backgrounds.",
		img: consoleMedia,
		alt: "The media library with a countdown in preview and live",
		points: [
			"Pictures in PNG, JPEG, GIF, BMP and WebP. Videos in MP4, MOV, M4V, WebM, MKV and AVI.",
			"PDFs too, with each page becoming a slide.",
			"Fit, crop, loop and mute for each item.",
			"Your church logo one shortcut away, for the moments between.",
		],
		docs: "features/media/",
	},
	{
		id: "presentations",
		title: "Sermon slides",
		lede: "Write the deck in Crater. The room sees the slides and the preacher sees the notes.",
		img: projSermon,
		alt: "A sermon title slide, The Lord Is My Shepherd, on the projector",
		points: [
			"Slide designs for a title, a section divider, title and content, two columns, a quote, a full picture or a blank slide.",
			"Speaker notes that show on the stage monitor and never on the congregation's screen.",
		],
		docs: "features/presentations/",
	},
	{
		id: "schedule",
		title: "Order of service",
		lede: "Plan it in the week and run it on Sunday.",
		img: schedule,
		alt: "The schedule with songs, a reading, sermon slides and a video in order",
		points: [
			"Songs, readings, media and slides in one list, in the order you'll use them.",
			"Drag to reorder. It saves itself a few seconds after every change.",
			"Keep schedules for later and load them again.",
		],
		docs: "features/schedules/",
	},
	{
		id: "screens",
		title: "Screens",
		lede: "One screen works. Add more as the room needs them.",
		img: projStage,
		alt: "The stage display with the current slide, the next one and a clock",
		points: [
			"A stage monitor for the platform, with the words large, speaker notes, what's next and a clock.",
			"Mirror screens for a lobby TV or overflow room, each with its own theme.",
			"Transitions from instant to a slow one second fade.",
			"Cast the live screen to a TV or phone browser on the same network, with no cable.",
			"With one display, the projection can sit full size behind the console while you prepare at home.",
		],
		docs: "features/outputs/",
	},
	{
		id: "streaming",
		title: "Streaming",
		lede: "Send the screen into OBS, vMix or Streamlabs over NDI on Windows. No capture card.",
		img: projSongCyan,
		alt: "Lyrics on screen in the cyan theme",
		points: [
			"Streams even with no projector attached.",
			"Give the stream its own look, like a lower third.",
			"Hide pictures and video on the stream while lyrics and scripture still go out.",
			"An on-demand mode for slow laptops that only sends a frame when something changes.",
		],
		docs: "features/ndi-streaming/",
	},
	{
		id: "themes",
		title: "Themes",
		lede: "Backgrounds, fonts, colours and text position, set once and reused every week.",
		img: consoleThemes,
		alt: "The theme editor",
		points: [
			"Separate themes for songs, scripture and presentations.",
			"A default theme for each screen, so the stage and the lobby can look different.",
			"Export a theme as a single file and import one from another church.",
		],
		docs: "features/themes/",
	},
	{
		id: "everyday",
		title: "Every week",
		lede: "The small things that make Sunday calm.",
		img: projCountdown,
		alt: "A countdown on the projector before the service",
		points: [
			"Works fully offline. No accounts, no analytics and no tracking.",
			"The console speaks 21 languages and picks your computer's language by itself.",
			"Updates are checked against a published SHA-256 checksum, and nothing installs until you click.",
			"Updates keep your songs, themes, schedules, media and settings.",
			"Keyboard shortcuts for everything that matters mid-service.",
		],
		docs: "reference/keyboard-shortcuts/",
	},
];
---

<Base title="Features · Crater" description="Everything Crater does: scripture, Strong's, songs, media, sermon slides, schedules, stage display, NDI streaming and themes.">
	<main>
		<PageHead lede="Scripture, songs, media and slides, with the screens and the stream around them. All of it free.">
			Everything Crater <span class="hl" data-hl>does</span>.
		</PageHead>

		<div class="wrap fx" data-fx>
			<nav class="fx-index" aria-label="On this page">
				<ul>
					{areas.map((a) => <li><a href={`#${a.id}`}>{a.title}</a></li>)}
				</ul>
			</nav>
			<div class="fx-list" data-fx-list>
				{
					areas.map((a, i) => (
						<>
						{/* Links and scroll triggers aim here: a card that has stuck
						    reports where it is stuck, not where it sits in the page. */}
						<span id={a.id} class="fx-anchor" data-fx-anchor />
						<section class="fx-item" data-fx-card style={`--i:${i}`} aria-labelledby={`${a.id}-title`}>
							<div class="fx-copy">
								<span class="fx-n">{String(i + 1).padStart(2, "0")}</span>
								<h2 class="display fx-title" id={`${a.id}-title`}>{a.title}</h2>
								<p class="lede">{a.lede}</p>
								<ul class="fx-points">
									{a.points.map((p) => <li>{p}</li>)}
								</ul>
								<a href={DOCS + a.docs} target="_blank" rel="noopener" class="fx-more">
									Read the guide
									<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
								</a>
							</div>
							<div class="fx-shot">
								<Image src={a.img} alt={a.alt} widths={[640, 1200]} sizes="(max-width: 900px) 100vw, 46vw" />
							</div>
						</section>
						{i < areas.length - 1 && <span class="fx-gap" aria-hidden="true" />}
						</>
					))
				}
			</div>
		</div>

		<Switch />

		<section class="wrap fx-end">
			<div class="card fx-cta" data-reveal="card">
				<h2 class="display h2">Something missing?</h2>
				<p class="lede">Tell us what your Sunday needs. Requests go straight to the people building Crater.</p>
				<div class="fx-cta-row">
					<a href="/request" class="btn btn-brand" data-magnetic>Request a feature</a>
					<a href="/download" class="btn btn-ghost" data-magnetic>Download Crater</a>
				</div>
			</div>
		</section>
	</main>
</Base>

<style>
	.fx {
		margin-top: 96px;
		display: grid;
		grid-template-columns: 200px minmax(0, 1fr);
		gap: clamp(32px, 5vw, 80px);
		align-items: start;
	}
	.fx-index {
		position: sticky;
		/* Level with the top of the stack when there is one. */
		top: var(--stack-top, 110px);
	}
	.fx-index ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2px;
		border-left: 1px solid var(--line);
	}
	.fx-index a {
		display: block;
		padding: 7px 0 7px 16px;
		margin-left: -1px;
		border-left: 1px solid transparent;
		font-size: 15px;
		color: var(--ink-3);
		transition:
			color 0.25s ease,
			border-color 0.25s ease;
	}
	.fx-index a:hover,
	.fx-index a.is-now {
		color: var(--ink);
		border-color: var(--brand);
	}
	.fx-list {
		display: flex;
		flex-direction: column;
	}
	.fx-anchor {
		display: block;
		height: 0;
		scroll-margin-top: 110px;
	}
	.fx-item {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		gap: clamp(28px, 4vw, 64px);
		align-items: center;
	}
	/* Wide enough to sit side by side: each feature is a card. */
	@media (min-width: 901px) {
		.fx-item {
			padding: clamp(28px, 3vw, 44px);
			border-radius: 28px;
			background: var(--card);
			border: 1px solid var(--line);
		}
	}
	/* The space between features. A spacer rather than a margin, because a
	   stuck card lets go early to keep room for its own margin. */
	.fx-gap {
		display: block;
		flex: none;
		height: clamp(72px, 9vw, 140px);
	}
	/* The script adds is-stacked when the whole stack fits the window. Each
	   card sticks a little lower than the last, so the edges above it show. */
	.fx-list.is-stacked {
		padding-bottom: 12vh;
	}
	.fx-list.is-stacked .fx-item {
		position: sticky;
		top: calc(var(--stack-top) + var(--i) * var(--stack-step));
		transform-origin: 50% 0;
		box-shadow: 0 -6px 18px -12px var(--shadow);
	}

	.fx-list.is-stacked .fx-gap {
		height: max(0px, calc(32vh - var(--even, 0px)));
	}
	.fx-n {
		font-variant-numeric: tabular-nums;
		font-size: 13px;
		color: var(--brand);
	}
	.fx-title {
		margin-top: 10px;
		font-size: clamp(30px, 3vw, 42px);
		line-height: 1.05;
		letter-spacing: -0.03em;
	}
	.fx-copy .lede {
		margin: 14px 0 0;
	}
	.fx-points {
		margin: 22px 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 12px;
		font-size: 15.5px;
		line-height: 1.5;
		color: var(--ink-2);
	}
	.fx-points li {
		position: relative;
		padding-left: 22px;
	}
	.fx-points li::before {
		content: "";
		position: absolute;
		left: 2px;
		top: 0.6em;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--ink-3);
	}
	.fx-more {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 24px;
		font-weight: 600;
		font-size: 15px;
		color: var(--brand);
	}
	.fx-more svg {
		transition: transform 0.4s var(--ease-out);
	}
	.fx-more:hover svg {
		transform: translateX(4px);
	}
	.fx-shot {
		border-radius: 14px;
		overflow: hidden;
		border: 1px solid var(--line-strong);
		box-shadow: 0 30px 80px -30px var(--shadow);
	}
	.fx-shot :global(img) {
		width: 100%;
	}
	.fx-item:nth-of-type(even) .fx-shot {
		order: -1;
	}
	.fx-end {
		padding-top: 160px;
	}
	.fx-cta {
		padding: clamp(32px, 5vw, 72px);
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.fx-cta .lede {
		margin: 18px auto 0;
		max-width: 520px;
	}
	.fx-cta-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
		margin-top: 32px;
	}
	@media (max-width: 1180px) {
		.fx {
			grid-template-columns: minmax(0, 1fr);
		}
		.fx-index {
			display: none;
		}
	}
	@media (max-width: 900px) {
		.fx-item {
			grid-template-columns: minmax(0, 1fr);
		}
		.fx-item .fx-shot,
		.fx-item:nth-of-type(even) .fx-shot {
			order: -1;
		}
	}
</style>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const fx = document.querySelector<HTMLElement>("[data-fx]")!;
	const list = document.querySelector<HTMLElement>("[data-fx-list]")!;
	const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-fx-card]"));
	const anchors = Array.from(document.querySelectorAll<HTMLElement>("[data-fx-anchor]"));
	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".fx-index a"));
	const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
	const MIN_TOP = 96;
	let top = MIN_TOP;
	const STEP = 12;
	list.style.setProperty("--stack-step", `${STEP}px`);

	const SCALE = 0.96;
	// How much to trim off the bottom of a covered card so it tucks behind
	// every card that will sit on top of it. Measuring against the shortest of
	// those, not just the next one, keeps it hidden after they are trimmed too.
	const trim = (i: number) => {
		const shortest = Math.min(...cards.slice(i + 1).map((c) => c.offsetHeight));
		return Math.max(0, Math.ceil(cards[i].offsetHeight - (STEP + shortest) / SCALE) + 2);
	};

	// Stack only when every card, at the depth it sticks at, still shows whole.
	let tweens: gsap.core.Tween[] = [];
	const layout = () => {
		// The stack sits in the middle of the window: the room the deepest card
		// needs is split above and below, but never higher than under the nav.
		const depth = Math.max(...cards.map((c, i) => i * STEP + c.offsetHeight));
		top = Math.max(MIN_TOP, Math.round((innerHeight - depth) / 2));
		const fits = innerWidth > 900 && top + depth <= innerHeight - 16;
		fx.style.setProperty("--stack-top", `${fits ? top : 110}px`);
		// A stuck card lets go when the end of the list reaches its bottom edge,
		// so a tall card would leave before a short one. Room under each short
		// card evens that out, and the gap after it shrinks by the same amount.
		cards.forEach((c, i) => {
			const even = fits ? depth - i * STEP - c.offsetHeight : 0;
			c.style.marginBottom = even ? `${even}px` : "";
			(c.nextElementSibling as HTMLElement | null)?.style.setProperty("--even", `${even}px`);
		});
		if (fits === list.classList.contains("is-stacked")) return ScrollTrigger.refresh();
		tweens.forEach((t) => {
			t.scrollTrigger?.kill();
			t.kill();
		});
		tweens = [];
		gsap.set(cards, { scale: 1, clearProps: "clipPath" });
		gsap.set(cards.flatMap((c) => Array.from(c.children)), { autoAlpha: 1 });
		list.classList.toggle("is-stacked", fits);
		// As each card slides over, the one beneath steps back and its content
		// fades, so only its edge shows above the new card.
		if (fits && !reduce)
			tweens = cards.slice(0, -1).flatMap((card, i) => {
				const scrollTrigger = { trigger: anchors[i + 1], start: "top bottom", end: () => `top ${top + (i + 1) * STEP}px`, scrub: true, invalidateOnRefresh: true };
				// Fading the content itself, not a variable it inherits, keeps each
				// scroll tick to one style change, and hidden content isn't painted.
				return [
					gsap.fromTo(
						card,
						{ scale: 1, clipPath: "inset(0px 0px 0px 0px round 28px)" },
						{ scale: SCALE, clipPath: () => `inset(0px 0px ${trim(i)}px 0px round 28px)`, ease: "none", scrollTrigger: { ...scrollTrigger, invalidateOnRefresh: true } },
					),
					gsap.to(card.children, { autoAlpha: 0, ease: "none", scrollTrigger }),
				];
			});
		ScrollTrigger.refresh();
	};
	layout();
	// Fonts arriving late reflow the cards, so measure again whenever any card
	// changes size, not only when the window does.
	let raf = 0;
	const again = () => {
		cancelAnimationFrame(raf);
		raf = requestAnimationFrame(layout);
	};
	addEventListener("resize", again);
	const ro = new ResizeObserver(again);
	cards.forEach((c) => ro.observe(c));

	// Light up the index entry for the card on top: the last one whose top
	// has reached the middle of the window. Works the same both ways.
	const mark = () => {
		let now = 0;
		cards.forEach((c, i) => {
			if (c.getBoundingClientRect().top <= innerHeight * 0.45) now = i;
		});
		links.forEach((a, i) => a.classList.toggle("is-now", i === now));
	};
	let marking = 0;
	addEventListener("scroll", () => (marking ||= requestAnimationFrame(() => ((marking = 0), mark()))), { passive: true });
	mark();
</script>
