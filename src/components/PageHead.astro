---
// The top of every inner page: a title and a line under it.
interface Props {
	lede?: string;
}
const { lede } = Astro.props;
---

<section class="phead">
	<div class="wrap phead-inner">
		<h1 class="display phead-title" data-reveal="up"><slot /></h1>
		{lede && <p class="lede phead-lede" data-reveal="up">{lede}</p>}
		<slot name="after" />
	</div>
</section>

<style>
	.phead {
		position: relative;
		padding-top: clamp(140px, 18vw, 200px);
		text-align: center;
	}
	.phead-inner {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.phead-title {
		max-width: 900px;
		font-size: clamp(42px, 5.6vw, 84px);
		line-height: 1;
	}
	.phead-lede {
		margin: 24px auto 0;
		max-width: 620px;
		font-size: 19px;
	}
</style>
