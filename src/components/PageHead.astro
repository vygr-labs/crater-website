---
// The top of every inner page: a title, a line under it and a low glow
// rising behind, a smaller echo of the home page's sunrise.
interface Props {
	lede?: string;
}
const { lede } = Astro.props;
---

<section class="phead">
	<div class="phead-glow" aria-hidden="true"></div>
	<div class="wrap phead-inner">
		<h1 class="display phead-title" data-reveal="up"><slot /></h1>
		{lede && <p class="lede phead-lede" data-reveal="up">{lede}</p>}
		<slot name="after" />
	</div>
</section>

<style>
	.phead {
		position: relative;
		padding-top: clamp(140px, 18vw, 200px);
		text-align: center;
	}
	.phead-glow {
		position: absolute;
		left: 50%;
		top: -520px;
		width: 1100px;
		height: 900px;
		margin-left: -550px;
		border-radius: 50%;
		background: radial-gradient(closest-side, var(--glow), transparent 72%);
		opacity: 0.7;
		pointer-events: none;
	}
	.phead-inner {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.phead-title {
		max-width: 900px;
		font-size: clamp(42px, 5.6vw, 84px);
		line-height: 1;
	}
	.phead-lede {
		margin: 24px auto 0;
		max-width: 620px;
		font-size: 19px;
	}
</style>
