---
// Keyboard first: real Crater shortcuts pressed in turn, with a small
// projector answering each one. Keys and actions match the app's F1 list.
// Clicking a shortcut in the list presses it on the demo.
import Mark from "../Mark.astro";

const list: [string[], string, string][] = [
	[["Enter"], "Send the preview live", "live"],
	[["↑", "↓"], "Previous or next slide", "step"],
	[["PgUp", "PgDn"], "Jump between choruses", "chorus"],
	[["Ctrl", "K"], "Search everything", "search"],
	[["Ctrl", "L"], "Logo on and off", "logo"],
	[["Ctrl", "C"], "Clear the text", "clear"],
	[["Ctrl", "P"], "Play or pause the video", "video"],
	[["F1"], "Every shortcut, any time", "help"],
];
const board = ["Ctrl", "K", "L", "C", "P", "↑", "↓", "Enter"];
---

<section id="keys" class="keys wrap" data-keys>
	<div class="keys-grid">
		<div class="keys-copy">
			<p class="eyebrow" data-reveal="up">Keyboard first</p>
			<h2 class="display h2" data-reveal="up">Run the service <span class="hl" data-hl>without the mouse</span>.</h2>
			<p class="lede" data-reveal="up">Eyes on the stage, hands on the keys. Everything that matters on a Sunday is one or two keys away.</p>
			<ul class="klist">
				{
					list.map(([keys, label, act]) => (
						<li data-reveal="row">
							<button type="button" class="krow" data-k-act={act}>
								<span class="kc-group">
									{keys.map((k) => (
										<kbd>{k}</kbd>
									))}
								</span>
								<span>{label}</span>
							</button>
						</li>
					))
				}
			</ul>
		</div>

		<div class="kdemo" data-reveal="card" aria-label="Shortcuts being pressed and the projector responding" role="img">
			<div class="kscreen">
				<div class="kstate" data-k="search">
					<div class="kpal">
						<span class="kpal-in"><span data-k-typed></span><i class="caret"></i></span>
						<span class="kpal-row is-hit">John 3:16 <small>KJV</small></span>
						<span class="kpal-row">John 3:17 <small>KJV</small></span>
					</div>
				</div>
				<div class="kstate" data-k="v16">
					<span class="kref">JOHN 3:16 · KJV</span>
					<p>For God so loved the world, that he gave his only begotten Son, that whosoever believeth in him should not perish, but have everlasting life.</p>
				</div>
				<div class="kstate" data-k="v17">
					<span class="kref">JOHN 3:17 · KJV</span>
					<p>For God sent not his Son into the world to condemn the world; but that the world through him might be saved.</p>
				</div>
				<div class="kstate" data-k="verse">
					<span class="kref">BLESSED ASSURANCE · VERSE 1</span>
					<p>Blessed assurance, Jesus is mine! O what a foretaste of glory divine!</p>
				</div>
				<div class="kstate" data-k="chorus">
					<span class="kref">BLESSED ASSURANCE · CHORUS</span>
					<p>This is my story, this is my song, praising my Saviour all the day long.</p>
				</div>
				<div class="kstate kstate-video" data-k="video">
					<span class="kvid-icon" data-k-vid-icon aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="currentColor"><path class="kvid-play" d="M8 5.5v13l11-6.5z"></path><path class="kvid-pause" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"></path></svg>
					</span>
					<span class="kvid-bar"><i></i></span>
				</div>
				<div class="kstate" data-k="help">
					<div class="kpal khelp">
						{
							list.map(([keys, label]) => (
								<span class="khelp-row">
									<span>{label}</span>
									<small>{keys.join(" ")}</small>
								</span>
							))
						}
					</div>
				</div>
				<div class="kstate kstate-logo" data-k="logo"><Mark size={64} /></div>
				<span class="kcap" data-k-cap></span>
			</div>
			<div class="kboard" aria-hidden="true">
				{board.map((k) => <kbd class="kkey" data-key={k}>{k}</kbd>)}
			</div>
		</div>
	</div>
</section>

<style>
	.keys {
		padding-top: 180px;
	}
	.keys-grid {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: clamp(32px, 5vw, 88px);
		align-items: center;
	}
	.keys-copy h2 {
		margin-top: 16px;
	}
	.keys-copy .lede {
		margin: 20px 0 0;
		max-width: 500px;
	}
	.klist {
		list-style: none;
		margin: 32px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 4px 24px;
	}
	.klist li {
		border-bottom: 1px solid var(--line);
	}
	.krow {
		width: 100%;
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 10px 0;
		border: 0;
		background: none;
		font: inherit;
		font-size: 14.5px;
		color: var(--ink-2);
		text-align: left;
		cursor: default;
		transition: color 0.2s ease;
	}
	/* Only clickable once the demo script is running. */
	.is-live .krow {
		cursor: pointer;
	}
	.is-live .krow:hover,
	.krow.is-now {
		color: var(--ink);
	}
	.is-live .krow:hover kbd,
	.krow.is-now kbd {
		border-color: var(--brand);
	}
	.krow:focus-visible {
		outline: 2px solid var(--brand);
		outline-offset: 2px;
		border-radius: 6px;
	}
	.kc-group {
		display: inline-flex;
		gap: 4px;
		flex: none;
	}
	kbd {
		display: inline-grid;
		place-items: center;
		min-width: 28px;
		height: 26px;
		padding: 0 7px;
		border-radius: 6px;
		border: 1px solid var(--line-strong);
		border-bottom-width: 2px;
		background: var(--card);
		color: var(--ink);
		font-family: var(--font-body);
		font-variant-numeric: tabular-nums;
		font-size: 12px;
		transition: border-color 0.2s ease;
	}
	.kdemo {
		padding: clamp(18px, 2.4vw, 32px);
		border-radius: 24px;
		background: var(--card);
		border: 1px solid var(--line);
	}
	.kscreen {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: 12px;
		overflow: hidden;
		background: #2a1022;
		container-type: inline-size;
		color: #fcf3f5;
	}
	.kstate {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 3cqw;
		padding: 0 9%;
		text-align: center;
		opacity: 0;
	}
	.kstate p {
		margin: 0;
		font-family: "Funnel Sans", var(--font-body);
		font-weight: 600;
		font-size: 3.6cqw;
		line-height: 1.3;
	}
	.kref {
		font-family: "Funnel Sans", var(--font-body);
		font-weight: 600;
		font-size: 2cqw;
		letter-spacing: 0.14em;
		color: #f29cac;
	}
	/* What Ctrl L shows before a church picks its own logo: the Crater
	   mark on a black matte, as on the projector. */
	.kstate-logo {
		background: #000;
	}
	.kstate-logo :global(.mark) {
		width: 12cqw;
		height: 12cqw;
		--mark-body: #f4f6f8;
		--brand: #2fd3e6;
	}
	/* A stand-in for a looping background video: a play or pause badge and
	   a running progress bar. */
	.kstate-video {
		background: #3a1530;
	}
	.kvid-icon {
		width: 9cqw;
		height: 9cqw;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: rgb(0 0 0 / 0.45);
		backdrop-filter: blur(6px);
		opacity: 0;
	}
	.kvid-icon svg {
		width: 45%;
		height: 45%;
	}
	.kvid-bar {
		position: absolute;
		left: 6%;
		right: 6%;
		bottom: 4%;
		height: 3px;
		border-radius: 3px;
		background: rgb(255 255 255 / 0.2);
		overflow: hidden;
	}
	.kvid-bar i {
		display: block;
		height: 100%;
		background: #fcf3f5;
		transform-origin: left;
		animation: kvid-run 12s linear infinite;
	}
	@keyframes kvid-run {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}
	.kstate-video.is-paused,
	.kstate-video.is-paused .kvid-bar i {
		animation-play-state: paused;
	}
	.kstate-video .kvid-pause,
	.kstate-video.is-paused .kvid-play {
		display: none;
	}
	.kstate-video.is-paused .kvid-pause {
		display: inline;
	}
	.kpal.khelp {
		width: 84%;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2px 14px;
		font-size: 1.7cqw;
	}
	.khelp-row {
		display: flex;
		justify-content: space-between;
		gap: 8px;
		padding: 0.9cqw 0.6cqw;
		border-bottom: 1px solid rgb(255 255 255 / 0.08);
		color: #a6b0b4;
	}
	.khelp-row small {
		font-size: 1em;
		color: #eef2f3;
		white-space: nowrap;
	}
	.kpal {
		width: 62%;
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 10px;
		border-radius: 12px;
		background: rgb(14 18 20 / 0.92);
		border: 1px solid rgb(255 255 255 / 0.12);
		box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.8);
		text-align: left;
		font-family: var(--font-body);
		font-size: 2.2cqw;
		color: #eef2f3;
	}
	.kpal-in {
		display: flex;
		align-items: center;
		padding: 8px 10px;
		border-radius: 8px;
		background: rgb(255 255 255 / 0.06);
		font-family: var(--font-body);
		font-variant-numeric: tabular-nums;
	}
	.caret {
		width: 1px;
		height: 1.1em;
		margin-left: 2px;
		background: #2fd3e6;
		animation: caret 1s steps(1) infinite;
	}
	@keyframes caret {
		50% {
			opacity: 0;
		}
	}
	.kpal-row {
		display: flex;
		justify-content: space-between;
		padding: 7px 10px;
		border-radius: 8px;
		color: #a6b0b4;
	}
	.kpal-row small {
		font-family: var(--font-body);
		font-variant-numeric: tabular-nums;
		font-size: 0.8em;
	}
	.kpal-row.is-hit {
		background: rgb(47 211 230 / 0.14);
		color: #eef2f3;
	}
	.kcap {
		position: absolute;
		left: 50%;
		bottom: 5%;
		transform: translateX(-50%);
		padding: 5px 12px;
		border-radius: 999px;
		background: rgb(0 0 0 / 0.55);
		backdrop-filter: blur(8px);
		font-family: var(--font-body);
		font-variant-numeric: tabular-nums;
		font-size: 12px;
		color: #eef2f3;
		white-space: nowrap;
		opacity: 0;
	}
	.kboard {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 24px;
	}
	.kkey {
		min-width: 54px;
		height: 50px;
		padding: 0 14px;
		border-radius: 10px;
		border-bottom-width: 4px;
		font-size: 14px;
		transition:
			transform 0.12s ease,
			border-bottom-width 0.12s ease,
			background-color 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease,
			box-shadow 0.3s ease;
	}
	.kkey.is-down {
		transform: translateY(3px);
		border-bottom-width: 1px;
		border-color: var(--brand);
		background: var(--brand-wash);
		color: var(--brand);
		box-shadow: 0 0 24px -4px var(--glow);
	}
	/* Still state for reduced motion and no JS: show the verse. */
	.kstate[data-k="v16"] {
		opacity: 1;
	}
	/* Beside the demo on a small laptop, two columns squeeze each label
	   onto three lines. One column reads better there. */
	@media (min-width: 901px) and (max-width: 1240px) {
		.klist {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 900px) {
		.keys-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 520px) {
		.klist {
			grid-template-columns: minmax(0, 1fr);
		}
		.kkey {
			min-width: 40px;
			height: 42px;
			padding: 0 10px;
		}
	}
</style>
