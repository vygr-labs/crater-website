---
// Open source, and what changed lately. The timeline draws down as it
// scrolls and each release lights its dot when it arrives.
const REPO = "https://github.com/vygr-labs/crater-v2";
const releases = [
	{
		v: "Next",
		note: "Merged, out in the next release",
		items: ["A select toggle on the schedule", "Home and End for the first and last slide, Page Up and Page Down for the chorus", "Scroll lists straight from the mouse wheel", "Auto-scroll you can set for each panel"],
	},
	{
		v: "0.7.5",
		note: "Songs and scripture polish",
		items: ["Song credits as a theme layer", "Song search matches short words", "Steadier verse numbers and current-verse highlight", "Tutorial and docs links inside the app"],
	},
	{
		v: "0.7.4",
		note: "One Bible library",
		items: ["Every profile shares one Bible library and picks its own translations", "Reorder translations by dragging", "Text outlines in themes", "A new logo, and no black flash when it goes up"],
	},
	{
		v: "0.7.3",
		note: "Profiles and Linux",
		items: ["Separate profiles you can switch, import and export", "Select many library items at once", "Full video controls in preview and live", "A Linux AppImage"],
	},
];
---

<section id="open" class="open wrap" data-open>
	<div class="open-grid">
		<div class="open-card card" data-reveal="card" data-spot>
			<svg class="open-graph" viewBox="0 0 400 220" aria-hidden="true">
				<path class="og" pathLength="1" d="M20 180 H380" />
				<path class="og" pathLength="1" d="M80 180 C 110 180, 110 120, 140 120 H260 C 290 120, 290 180, 320 180" />
				<path class="og" pathLength="1" d="M160 120 C 190 120, 190 60, 220 60 H250 C 270 60, 270 120, 290 120" />
				<circle class="on" cx="20" cy="180" r="5"></circle>
				<circle class="on" cx="80" cy="180" r="5"></circle>
				<circle class="on" cx="140" cy="120" r="5"></circle>
				<circle class="on" cx="220" cy="60" r="5"></circle>
				<circle class="on" cx="260" cy="120" r="5"></circle>
				<circle class="on" cx="320" cy="180" r="5"></circle>
				<circle class="on on-head" cx="380" cy="180" r="7"></circle>
			</svg>
			<p class="eyebrow">Open source</p>
			<h2 class="display open-title">Built in the open, <span class="hl" data-hl>for the church</span>.</h2>
			<p class="lede">Every line of Crater is on GitHub. Read it, build it yourself, report a problem or send a fix. Nothing is held back for a paid version, because there isn't one.</p>
			<div class="open-ctas">
				<a href={REPO} target="_blank" rel="noopener" class="btn btn-ghost" data-magnetic>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path></svg>
					View the source
				</a>
				<a href={`${REPO}/issues`} target="_blank" rel="noopener" class="link-arrow u-link">Report a problem</a>
			</div>
		</div>

		<div class="changelog">
			<p class="eyebrow" data-reveal="up">What's new</p>
			<div class="cl" data-cl>
				<span class="cl-line" aria-hidden="true"><span data-cl-fill></span></span>
				<ol class="cl-list">
				{
					releases.map((r) => (
						<li class="cl-item" data-cl-item>
							<span class="cl-dot" aria-hidden="true" />
							<div class="cl-head">
								{r.v === "Next" ? <span class="cl-v"><span class="hl" data-hl>Next</span></span> : <span class="cl-v">v{r.v}</span>}
								<span class="cl-note">{r.note}</span>
							</div>
							<ul>
								{r.items.map((it) => (
									<li>{it}</li>
								))}
							</ul>
						</li>
					))
				}
				</ol>
			</div>
			<a href={`${REPO}/releases`} target="_blank" rel="noopener" class="link-arrow u-link cl-all">Every release on GitHub</a>
		</div>
	</div>
</section>

<style>
	.open {
		padding-top: 180px;
	}
	.open-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(24px, 4vw, 64px);
		align-items: start;
	}
	.open-card {
		position: relative;
		padding: clamp(28px, 3.4vw, 48px);
		overflow: hidden;
		isolation: isolate;
	}
	.open-card::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(480px circle at var(--mx, 50%) var(--my, -40%), var(--brand-wash), transparent 60%);
	}
	.open-graph {
		display: block;
		width: 100%;
		max-width: 420px;
		height: auto;
		margin-bottom: 28px;
		overflow: visible;
	}
	.og {
		fill: none;
		stroke: var(--line-strong);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.og:nth-of-type(2) {
		stroke: var(--brand);
	}
	.og:nth-of-type(3) {
		stroke: var(--ink-3);
	}
	.on {
		fill: var(--card);
		stroke: var(--ink-3);
		stroke-width: 2;
	}
	.on-head {
		stroke: var(--brand);
		fill: var(--brand);
	}
	.open-title {
		margin-top: 14px;
		font-size: clamp(30px, 3.2vw, 44px);
		line-height: 1.05;
	}
	.open-card .lede {
		margin: 18px 0 0;
		max-width: 520px;
	}
	.open-ctas {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 20px;
		margin-top: 32px;
	}
	.link-arrow {
		color: var(--brand);
		font-weight: 500;
	}
	.changelog {
		padding-top: 8px;
	}
	.cl {
		position: relative;
		margin: 24px 0 0;
		padding: 0 0 0 32px;
	}
	.cl-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.cl-line {
		position: absolute;
		left: 5px;
		top: 8px;
		bottom: 8px;
		width: 2px;
		background: var(--line);
	}
	.cl-line span {
		position: absolute;
		inset: 0;
		background: var(--brand);
		transform: scaleY(0);
		transform-origin: top;
	}
	.cl-item {
		position: relative;
		padding-bottom: 28px;
	}
	.cl-dot {
		position: absolute;
		left: -32px;
		top: 6px;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--bg);
		border: 2px solid var(--line-strong);
		transition:
			border-color 0.4s ease,
			background-color 0.4s ease,
			box-shadow 0.6s ease;
	}
	.cl-item.is-on .cl-dot {
		border-color: var(--brand);
		background: var(--brand);
		box-shadow: 0 0 0 6px var(--brand-wash);
	}
	.cl-head {
		display: flex;
		align-items: baseline;
		gap: 12px;
		flex-wrap: wrap;
	}
	.cl-v {
		font-family: var(--font-display);
		font-size: 22px;
		font-weight: 600;
	}
	.cl-note {
		font-size: 14px;
		color: var(--ink-3);
	}
	.cl-item ul {
		margin: 10px 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 6px;
	}
	.cl-item ul li {
		position: relative;
		padding-left: 16px;
		font-size: 15px;
		color: var(--ink-2);
	}
	.cl-item ul li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.7em;
		width: 6px;
		height: 1px;
		background: var(--ink-3);
	}
	.cl-all {
		display: inline-block;
		margin-left: 32px;
	}
	@media (max-width: 900px) {
		.open-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
